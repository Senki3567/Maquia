Dialogue: 0,1:51:09.97,1:51:21.11,Viator,,0,0,0,,{\fad(500,500)\be3}Taiyou wa noboru kara kitto
Dialogue: 0,1:51:34.83,1:51:41.27,Viator,,0,0,0,,{\fad(500,500)\be3}Chippoke na hoshi yo
Dialogue: 0,1:51:42.32,1:51:49.06,Viator,,0,0,0,,{\fad(500,500)\be3}Ochita namida wa
Dialogue: 0,1:51:49.36,1:51:56.51,Viator,,0,0,0,,{\fad(500,500)\be3}Afuresou na yasashisa wo
Dialogue: 0,1:51:56.83,1:52:00.08,Viator,,0,0,0,,{\fad(500,500)\be3}Misete kureru
Dialogue: 0,1:52:00.61,1:52:09.33,Viator,,0,0,0,,{\fad(500,500)\be3}Mou ichidou waratte
Dialogue: 0,1:52:42.63,1:52:58.33,Viator,,0,0,0,,{\fad(500,500)\be3}Sono mune no naka ni wa nani ga aru no?
Dialogue: 0,1:53:01.54,1:53:10.04,Viator,,0,0,0,,{\fad(500,500)\be3}Arukidasu ai ni natte
Dialogue: 0,1:53:10.43,1:53:16.33,Viator,,0,0,0,,{\fad(500,500)\be3}Hikari no naka e
Dialogue: 0,1:53:16.62,1:53:27.12,Viator,,0,0,0,,{\fad(500,500)\be3}Daijoubu donna mirai demo
Dialogue: 0,1:53:27.36,1:53:39.33,Viator,,0,0,0,,{\fad(500,500)\be3}Taiyou wa noboru kara kitto
Dialogue: 0,1:49:47.21,1:49:53.55,Viator - Viet,,0,0,0,,{\fad(500,500)\be3}Vì sao nhỏ bé
Dialogue: 0,1:49:54.76,1:50:01.32,Viator - Viet,,0,0,0,,{\fad(500,500)\be3}Cứ xoay, xoay mãi
Dialogue: 0,1:50:01.81,1:50:08.91,Viator - Viet,,0,0,0,,{\fad(500,500)\be3}Đắm mình trong ánh sáng ngập tràn
Dialogue: 0,1:50:09.33,1:50:12.70,Viator - Viet,,0,0,0,,{\fad(500,500)\be3}Xuôi theo dòng chảy
Dialogue: 0,1:50:13.04,1:50:20.77,Viator - Viet,,0,0,0,,{\fad(500,500)\be3}Ôi thật đẹp làm sao
Dialogue: 0,1:50:44.14,1:50:52.64,Viator - Viet,,0,0,0,,{\fad(500,500)\be3}Tiến về phía trước, đưa tình yêu đi cùng
Dialogue: 0,1:50:52.98,1:50:58.96,Viator - Viet,,0,0,0,,{\fad(500,500)\be3}Ngỡ như khúc ca êm đềm
Dialogue: 0,1:50:59.06,1:51:09.86,Viator - Viet,,0,0,0,,{\fad(500,500)\be3}Ta vẫn tin, rằng dù mang hình hài thế nào
Dialogue: 0,1:51:09.97,1:51:21.11,Viator - Viet,,0,0,0,,{\fad(500,500)\be3}Thì ánh dương ngày mai rồi cũng sẽ đến
Dialogue: 0,1:51:34.83,1:51:41.27,Viator - Viet,,0,0,0,,{\fad(500,500)\be3}Những giọt lệ
Dialogue: 0,1:51:42.32,1:51:49.06,Viator - Viet,,0,0,0,,{\fad(500,500)\be3}Rơi xuống từ vì sao nhỏ bé
Dialogue: 0,1:51:49.36,1:51:56.51,Viator - Viet,,0,0,0,,{\fad(500,500)\be3}Nhẹ nhàng phủ lên vạn vật
Dialogue: 0,1:51:56.83,1:52:00.08,Viator - Viet,,0,0,0,,{\fad(500,500)\be3}Một lần nữa thôi
Dialogue: 0,1:52:00.61,1:52:09.33,Viator - Viet,,0,0,0,,{\fad(500,500)\be3}Ta muốn ngắm nụ cười trên môi người
Dialogue: 0,1:52:42.63,1:52:58.33,Viator - Viet,,0,0,0,,{\fad(500,500)\be3}Trong tim ta giờ đây còn lại thứ chi?
Dialogue: 0,1:53:01.54,1:53:10.04,Viator - Viet,,0,0,0,,{\fad(500,500)\be3}Tiến về phía trước, hoá thành tình yêu
Dialogue: 0,1:53:10.43,1:53:16.33,Viator - Viet,,0,0,0,,{\fad(500,500)\be3}Để rồi hòa mình vào ánh sáng
Dialogue: 0,1:53:16.62,1:53:27.12,Viator - Viet,,0,0,0,,{\fad(500,500)\be3}Không sao đâu, dù sau này có xảy ra chuyện gì
Dialogue: 0,1:53:27.36,1:53:39.33,Viator - Viet,,0,0,0,,{\fad(500,500)\be3}Thì ánh dương ngày mai rồi cũng đến
Dialogue: 0,0:01:00.02,0:01:02.78,Italics,,0,0,0,,Sợi dọc tượng trưng cho dòng chảy thời gian.
Dialogue: 0,0:01:04.44,0:01:07.02,Italics,,0,0,0,,Khi giao mùa, sắc trời sẽ bao bọc lấy chúng.
Dialogue: 0,0:01:08.69,0:01:10.93,Italics,,0,0,0,,Còn sợi ngang tượng trưng cho sinh nghiệp của con người.
Dialogue: 0,0:01:12.64,0:01:15.51,Italics,,0,0,0,,Chúng giúp con người ta vững tâm và biết rung cảm.
Dialogue: 0,0:01:17.37,0:01:20.48,Italics,,0,0,0,,Người Iorph sẽ tiếp tục dệt Hibiol...
Dialogue: 0,0:01:22.20,0:01:26.81,Italics,,0,0,0,,đến tận hàng trăm năm sau, suốt quãng đời dài đằng đẳng của mình.
Dialogue: 0,0:01:43.13,0:01:43.93,Default,,0,0,0,,Maquia!
Dialogue: 0,0:01:48.64,0:01:49.47,Default,,0,0,0,,Leilia!
Dialogue: 0,0:01:51.14,0:01:52.59,Default,,0,0,0,,Cậu làm cái gì thế hả?
Dialogue: 0,0:01:53.10,0:01:54.83,Default,,0,0,0,,Chơi bời miết như thế thì sao mà xong việc được.
Dialogue: 0,0:01:57.17,0:01:59.13,Default,,0,0,0,,Nè, Maquia cũng xuống đây đi!
Dialogue: 0,0:01:59.31,0:02:00.52,Default,,0,0,0,,Nhảy xuống đây đi!
Dialogue: 0,0:02:01.35,0:02:04.66,Default,,0,0,0,,T-Tớ không làm được đâu...
Dialogue: 0,0:02:07.55,0:02:08.44,Default,,0,0,0,,Đồ thỏ đế!
Dialogue: 0,0:02:11.66,0:02:12.40,Default,,0,0,0,,Maquia.
Dialogue: 0,0:02:12.84,0:02:14.80,Default,,0,0,0,,Cậu không cần phải làm theo lời con nhỏ ngỗ nghịch đó đâu.
Dialogue: 0,0:02:15.17,0:02:15.76,Default,,0,0,0,,Krim...
Dialogue: 0,0:02:16.76,0:02:19.78,Default,,0,0,0,,Cậu ấy... thiệt là...
Dialogue: 0,0:02:30.37,0:02:35.44,Italics,,0,0,0,,Chủng tộc sống ở nơi tách biệt với xứ sở loài người, \Ndành cả đời dệt vải, được gọi là...
Dialogue: 0,0:02:38.18,0:02:39.90,Italics,,0,0,0,,{\fad(0,500)}gia tộc Ly Biệt...
Dialogue: 0,0:02:44.80,0:02:47.36,Default,,0,0,0,,Có chuyện gì vậy, Racine-sama?
Dialogue: 0,0:02:49.85,0:02:50.70,Default,,0,0,0,,Không có gì.
Dialogue: 0,0:02:52.85,0:02:54.71,Default,,0,0,0,,Lần sau Maquia phải làm đấy nhé!
Dialogue: 0,0:02:59.08,0:03:00.04,Default,,0,0,0,,Mẹ!
Dialogue: 0,0:03:00.75,0:03:02.29,Default,,0,0,0,,Mừng mẹ về!
Dialogue: 0,0:03:04.32,0:03:06.65,Default,,0,0,0,,Đừng đối xử với vải như thế chứ!
Dialogue: 0,0:03:07.60,0:03:08.83,Default,,0,0,0,,Con xin lỗi!
Dialogue: 0,0:03:09.52,0:03:10.77,Default,,0,0,0,,Mình mẩy ướt hết cả rồi này.
Dialogue: 0,0:03:11.24,0:03:13.04,Default,,0,0,0,,Cha có tìm được hoa nào đẹp không?
Dialogue: 0,0:03:13.23,0:03:15.54,Default,,0,0,0,,Ừ, ta có thể dùng chúng nhuộm màu sáng cho vải.
Dialogue: 0,0:03:18.15,0:03:20.17,Default,,0,0,0,,Chào cậu nhé, Maquia!
Dialogue: 0,0:03:20.72,0:03:21.77,Default,,0,0,0,,Tạm biệt.
Dialogue: 0,0:03:27.63,0:03:28.68,Default,,0,0,0,,Tạm biệt...
Dialogue: 0,0:03:35.97,0:03:36.93,Default,,0,0,0,,Những sợi vải...
Dialogue: 0,0:03:51.22,0:03:52.77,Default,,0,0,0,,Sao con lại khóc?
Dialogue: 0,0:03:54.82,0:03:56.39,Default,,0,0,0,,Vì con chỉ có một mình ạ.
Dialogue: 0,0:03:57.01,0:03:59.60,Default,,0,0,0,,Một mình? Dù có ta ở đây ư?
Dialogue: 0,0:04:00.60,0:04:02.16,Default,,0,0,0,,Trưởng lão, không phải...!
Dialogue: 0,0:04:03.77,0:04:06.13,Default,,0,0,0,,Con đúng là đứa mít ướt mà.
Dialogue: 0,0:04:07.52,0:04:11.66,Default,,0,0,0,,Con có biết vì sao chúng ta lại được gọi là tộc Ly Biệt không?
Dialogue: 0,0:04:13.49,0:04:18.26,Default,,0,0,0,,Chúng ta, chủng tộc trường thọ có hình dáng không mấy thay đổi dù qua bao năm tháng.
Dialogue: 0,0:04:18.89,0:04:20.85,Default,,0,0,0,,Đối với những người không được như vậy...
Dialogue: 0,0:04:20.96,0:04:22.86,Default,,0,0,0,,thì chúng ta giống như những sinh vật bước ra từ truyện cổ tích vậy.
Dialogue: 0,0:04:24.37,0:04:26.58,Default,,0,0,0,,Cho đến vài trăm năm về trước,
Dialogue: 0,0:04:27.17,0:04:29.39,Default,,0,0,0,,người ta có thể tìm thấy những sinh vật như chúng ta ở bất cứ đâu.
Dialogue: 0,0:04:30.24,0:04:32.69,Default,,0,0,0,,Tộc người có đôi cánh như loài chim.
Dialogue: 0,0:04:33.53,0:04:35.50,Default,,0,0,0,,Hay loài hoa cất tiếng hát trước lúc bình minh.
Dialogue: 0,0:04:36.39,0:04:39.82,Default,,0,0,0,,Hay là loài cá khổng lồ lướt trên dòng nước.
Dialogue: 0,0:04:41.18,0:04:41.85,Default,,0,0,0,,Nhưng mà...
Dialogue: 0,0:04:42.85,0:04:46.94,Default,,0,0,0,,tất cả chúng đều đã xa rời thế giới này.
Dialogue: 0,0:04:50.26,0:04:51.33,Default,,0,0,0,,Chính vì vậy...
Dialogue: 0,0:04:51.82,0:04:54.55,Default,,0,0,0,,mà chúng ta mới phải tiếp tục dệt Hibiol.
Dialogue: 0,0:04:55.97,0:04:58.37,Default,,0,0,0,,Nếu ở đây thì con sẽ không cô độc.
Dialogue: 0,0:04:59.38,0:05:03.40,Default,,0,0,0,,Những ký ức không ai biết đến qua bao năm tháng...
Dialogue: 0,0:05:03.60,0:05:05.64,Default,,0,0,0,,đều được Hibiol nhớ đến.
Dialogue: 0,0:05:07.01,0:05:10.01,Default,,0,0,0,,Những người không nói được lời từ biệt...
Dialogue: 0,0:05:11.08,0:05:14.37,Default,,0,0,0,,sẽ khóc cùng con bên trong Hibiol.
Dialogue: 0,0:05:15.18,0:05:17.60,Default,,0,0,0,,Khóc cùng con ư...?
Dialogue: 0,0:05:19.14,0:05:23.00,Default,,0,0,0,,Nhưng nếu con rời bỏ tộc Iorph...
Dialogue: 0,0:05:25.53,0:05:28.40,Default,,0,0,0,,bước vào thế giới bên ngoài,
Dialogue: 0,0:05:29.70,0:05:31.24,Default,,0,0,0,,thì đừng đem lòng yêu bất kỳ ai.
Dialogue: 0,0:05:32.39,0:05:35.46,Default,,0,0,0,,Khi đã yêu, thì con sẽ trở thành kẻ cô độc thực sự.
Dialogue: 0,0:05:37.46,0:05:41.04,Default,,0,0,0,,Gặp người khác rồi.... con vẫn sẽ cô độc ạ?
Dialogue: 0,0:05:41.65,0:05:43.16,Default,,0,0,0,,Đó là số mệnh...
Dialogue: 0,0:05:43.70,0:05:47.51,Default,,0,0,0,,mà Thượng đế trao cho tộc Ly Biệt chúng ta.
Dialogue: 0,0:05:51.01,0:05:52.22,Default,,0,0,0,,Chúc Người ngủ ngon!
Dialogue: 0,0:05:52.62,0:05:54.27,Default,,0,0,0,,Ngủ ngon, Maquia.
Dialogue: 0,0:05:55.26,0:05:58.40,Default,,0,0,0,,Đừng quên dệt Hibiol của hôm nay nhé.
Dialogue: 0,0:05:58.70,0:05:59.43,Default,,0,0,0,,Vâng.
Dialogue: 0,0:07:27.72,0:07:28.69,Default,,0,0,0,,Nở rồi.
Dialogue: 0,0:07:44.42,0:07:45.23,Default,,0,0,0,,Maquia?!
Dialogue: 0,0:07:55.99,0:07:56.71,Default,,0,0,0,,Bọn Renato?!
Dialogue: 0,0:07:59.02,0:08:00.27,Default,,0,0,0,,Vậy tức là Mezarte đã...
Dialogue: 0,0:08:00.74,0:08:01.39,Default,,0,0,0,,Maquia!
Dialogue: 0,0:08:01.86,0:08:03.22,Default,,0,0,0,,Mau tới chỗ trưởng lão!
Dialogue: 0,0:08:08.56,0:08:09.64,Default,,0,0,0,,Trưởng lão!
Dialogue: 0,0:08:25.41,0:08:26.53,Default,,0,0,0,,Trưởng lão!
Dialogue: 0,0:08:30.48,0:08:31.45,Default,,0,0,0,,Trưởng lão...!
Dialogue: 0,0:08:33.38,0:08:34.70,Default,,0,0,0,,Trưởng lão!
Dialogue: 0,0:08:34.70,0:08:35.91,Default,,0,0,0,,Bọn Renato có trang bị vũ khí!
Dialogue: 0,0:08:36.11,0:08:37.45,Default,,0,0,0,,Bảo vệ Hibiol!
Dialogue: 0,0:09:04.22,0:09:04.95,Default,,0,0,0,,Kia kìa!
Dialogue: 0,0:09:14.47,0:09:15.86,Default,,0,0,0,,Lời đồn quả không sai.
Dialogue: 0,0:09:15.86,0:09:17.89,Default,,0,0,0,,Toàn một lũ nhóc.
Dialogue: 0,0:09:18.13,0:09:21.67,Default,,0,0,0,,Này, không phải mày khoái mấy thể loại này lắm sao?
Dialogue: 0,0:09:21.82,0:09:22.60,Default,,0,0,0,,Lui lại!
Dialogue: 0,0:09:23.67,0:09:24.65,Default,,0,0,0,,Đoàn trưởng Izor.
Dialogue: 0,0:09:40.03,0:09:41.37,Default,,0,0,0,,Ai là kẻ đứng đầu làng này?
Dialogue: 0,0:09:46.49,0:09:47.40,Default,,0,0,0,,Ra là vậy.
Dialogue: 0,0:09:48.59,0:09:49.99,Default,,0,0,0,,Rất hân hạnh.
Dialogue: 0,0:09:50.84,0:09:52.20,Default,,0,0,0,,Dù mang diện mạo của một thiếu nữ...
Dialogue: 0,0:09:52.54,0:09:56.96,Default,,0,0,0,,nhưng tôi nghe nói thật ra bà là một con quái vật 400 năm tuổi.
Dialogue: 0,0:09:58.16,0:10:01.59,Default,,0,0,0,,Suốt đời, chúng tôi chỉ có một công việc là dệt Hibiol hết ngày này qua tháng nọ,
Dialogue: 0,0:10:01.97,0:10:03.75,Default,,0,0,0,,việc đó được lặp đi lặp lại nhiều lần.
Dialogue: 0,0:10:04.58,0:10:06.52,Default,,0,0,0,,Chúng tôi không rảnh tiếp những kẻ như mấy người.
Dialogue: 0,0:10:06.52,0:10:08.56,Default,,0,0,0,,Chuyện đó không phải do bà quyết định.
Dialogue: 0,0:10:10.26,0:10:11.67,Default,,0,0,0,,Đây là lệnh của đức vua.
Dialogue: 0,0:10:12.10,0:10:15.44,Default,,0,0,0,,Bà phải theo chúng tôi về hoàng cung Mezarte.
Dialogue: 0,0:10:16.10,0:10:17.81,Default,,0,0,0,,Không được đến gần Racine-sama!
Dialogue: 0,0:10:21.24,0:10:21.97,Default,,0,0,0,,Nữ nhi!
Dialogue: 0,0:10:22.38,0:10:23.36,Default,,0,0,0,,Bắt hết nữ nhi!
Dialogue: 0,0:10:24.32,0:10:27.17,Default,,0,0,0,,Kẻ nào dám chống cự thì giết không tha!
Dialogue: 0,0:10:36.62,0:10:38.08,Default,,0,0,0,,Con này bị bệnh Mắt đỏ rồi...!
Dialogue: 0,0:10:43.76,0:10:44.62,Default,,0,0,0,,Mặc kệ nó!
Dialogue: 0,0:10:45.07,0:10:46.55,Default,,0,0,0,,Phải bắt người Iorph trước!
Dialogue: 0,0:10:56.61,0:10:58.26,Default,,0,0,0,,Thả tôi ra! Thả t...!
Dialogue: 0,0:11:29.53,0:11:30.18,Default,,0,0,0,,Maquia!
Dialogue: 0,0:12:49.19,0:12:49.99,Default,,0,0,0,,Không...
Dialogue: 0,0:12:51.42,0:12:55.92,Default,,0,0,0,,{\fad(0,1000)}KHÔNG...!
Dialogue: 0,0:13:21.40,0:13:23.98,Flashback,,0,0,0,,{\fad(500,0)}Nè, Maquia cũng xuống đây đi!
Dialogue: 0,0:13:24.43,0:13:26.00,Flashback,,0,0,0,,{\fad(0,500)}Mau nhảy xuống đây đi!
Dialogue: 0,0:14:07.58,0:14:09.20,Default,,0,0,0,,M-Một đứa bé...
Dialogue: 0,0:14:09.34,0:14:10.82,Default,,0,0,0,,Rượu được chưng cất từ nước mắt...
Dialogue: 0,0:14:14.06,0:14:16.18,Default,,0,0,0,,uống rất ngon bởi nó có vị mặn.
Dialogue: 0,0:14:18.60,0:14:21.12,Default,,0,0,0,,Cô là Maquia ở chỗ trưởng lão phải không?
Dialogue: 0,0:14:22.58,0:14:25.97,Default,,0,0,0,,Tôi đến mua Hibiol, nào ngờ lại bị kẹt ở đây.
Dialogue: 0,0:14:27.16,0:14:30.56,Default,,0,0,0,,Đây là nơi trú thân của những kẻ lang thang, nhưng xem ra họ đều bị thổ phỉ giết hết rồi.
Dialogue: 0,0:14:31.33,0:14:33.62,Default,,0,0,0,,Thằng bé này thì chỉ vừa mới ra đời nữa chứ.
Dialogue: 0,0:14:39.09,0:14:42.18,Default,,0,0,0,,Quả là một người mẹ tuyệt vời nhỉ?
Dialogue: 0,0:14:42.46,0:14:45.02,Default,,0,0,0,,Chết rồi nhưng vẫn cố bảo vệ đứa con.
Dialogue: 0,0:14:45.37,0:14:49.24,Default,,0,0,0,,Cơ mà, cứ để mặc nó thế này thì sớm muộn gì mẹ con cũng đoàn tụ dưới suối vàng.
Dialogue: 0,0:14:49.68,0:14:51.78,Default,,0,0,0,,Hibiol của thằng bé này đến đây là hết rồi.
Dialogue: 0,0:14:51.94,0:14:56.08,Default,,0,0,0,,Một mảnh nhỏ cắt ra thì không thể gọi là vải được.
Dialogue: 0,0:14:56.94,0:14:59.62,Default,,0,0,0,,Nhưng vẫn hơn là ở lại đây một mình.
Dialogue: 0,0:15:02.24,0:15:04.10,Default,,0,0,0,,Đứa trẻ này chỉ có một mình thật à?
Dialogue: 0,0:15:36.53,0:15:38.83,Default,,0,0,0,,Sức mạnh này... thật tuyệt vời...
Dialogue: 0,0:15:40.85,0:15:41.73,Default,,0,0,0,,Thật tuyệt vời...
Dialogue: 0,0:15:42.55,0:15:44.41,Default,,0,0,0,,Thôi nào thôi nào.
Dialogue: 0,0:15:52.75,0:15:54.61,Default,,0,0,0,,Tính đem nó theo à?
Dialogue: 0,0:15:56.85,0:15:57.84,Default,,0,0,0,,Không phải đồ chơi đâu đấy...
Dialogue: 0,0:15:57.84,0:15:58.93,Default,,0,0,0,,Thằng bé không phải đồ chơi.
Dialogue: 0,0:16:00.64,0:16:01.35,Default,,0,0,0,,Mà nó là...
Dialogue: 0,0:16:03.77,0:16:05.02,Default,,0,0,0,,Hibiol của tôi.
Dialogue: 0,0:16:07.51,0:16:08.80,Default,,0,0,0,,Thật là...
Dialogue: 0,0:16:09.04,0:16:12.11,Default,,0,0,0,,Một kẻ cô độc gặp một kẻ cô độc khác à?
Dialogue: 0,0:16:18.17,0:16:19.00,Default,,0,0,0,,Nhóc thấy lạnh à?
Dialogue: 0,0:16:30.89,0:16:32.04,Default,,0,0,0,,Mùi lạ thật đấy.
Dialogue: 0,0:16:34.01,0:16:35.73,Default,,0,0,0,,{\fad(0,500)}Cứ như mùi của vầng mặt trời vậy.
Dialogue: 0,0:16:45.91,0:16:46.33,Default,,0,0,0,,Đau!
Dialogue: 0,0:16:46.67,0:16:48.08,Default,,0,0,0,,Ở đây nè!
Dialogue: 0,0:16:47.60,0:16:48.58,Default,,0,0,0,,Đứng lại!
Dialogue: 0,0:16:50.98,0:16:52.49,Default,,0,0,0,,Lang! Deol!
Dialogue: 0,0:16:52.65,0:16:54.07,Default,,0,0,0,,Sao không chịu làm việc vậy hả?!
Dialogue: 0,0:16:55.58,0:16:56.57,Default,,0,0,0,,Lại đây nè!
Dialogue: 0,0:16:56.06,0:16:57.06,Default,,0,0,0,,Đứng lại!
Dialogue: 0,0:16:57.17,0:16:58.30,Default,,0,0,0,,Mơ đi nhá!
Dialogue: 0,0:16:57.49,0:16:58.30,Default,,0,0,0,,Cái thằng kia...!
Dialogue: 0,0:16:58.37,0:17:00.28,Default,,0,0,0,,Thiệt tình, 2 cái đứa bướng bỉnh này.
Dialogue: 0,0:17:02.42,0:17:03.54,Default,,0,0,0,,Chuyện gì vậy, Onora?
Dialogue: 0,0:17:19.77,0:17:20.78,Default,,0,0,0,,Vú...
Dialogue: 0,0:17:22.30,0:17:23.32,Default,,0,0,0,,Vú...
Dialogue: 0,0:17:24.10,0:17:25.44,Default,,0,0,0,,Vú, cháu kh...!
Dialogue: 0,0:17:27.24,0:17:28.50,Default,,0,0,0,,Cháu không biết tìm ở đâu cả...!
Dialogue: 0,0:17:33.22,0:17:34.49,Default,,0,0,0,,Này nhé.
Dialogue: 0,0:17:35.20,0:17:38.79,Default,,0,0,0,,Trẻ con thì sao mà nuôi được trẻ con chứ hả?
Dialogue: 0,0:17:42.93,0:17:44.70,Default,,0,0,0,,Đó là con của cậu à?
Dialogue: 0,0:17:49.90,0:17:52.69,Default,,0,0,0,,Diện mạo không thể hiện tuổi của người Iorph có phải không?
Dialogue: 0,0:17:53.19,0:17:53.90,Default,,0,0,0,,Con của cậu à?
Dialogue: 0,0:17:56.45,0:17:57.89,Default,,0,0,0,,Lang, Deol.
Dialogue: 0,0:17:58.61,0:18:01.33,Default,,0,0,0,,C-Cháu, chỉ mới, 15 tuổi...
Dialogue: 0,0:18:01.89,0:18:03.53,Default,,0,0,0,,Đứa bé này... thì không...
Dialogue: 0,0:18:04.22,0:18:05.13,Default,,0,0,0,,Cháu không biết nữa.
Dialogue: 0,0:18:15.32,0:18:16.59,Default,,0,0,0,,Tên đứa bé là gì?
Dialogue: 0,0:18:18.00,0:18:19.11,Default,,0,0,0,,Cháu không biết.
Dialogue: 0,0:18:20.10,0:18:21.19,Default,,0,0,0,,Kì quặc.
Dialogue: 0,0:18:21.59,0:18:22.75,Default,,0,0,0,,Chị gái kì quặc!
Dialogue: 0,0:18:23.05,0:18:24.47,Default,,0,0,0,,Thằng nhỏ kì quặc!
Dialogue: 0,0:18:24.52,0:18:25.47,Default,,0,0,0,,Leilia!
Dialogue: 0,0:18:27.70,0:18:28.58,Default,,0,0,0,,Leilia...
Dialogue: 0,0:18:29.52,0:18:30.77,Default,,0,0,0,,Đấy là tên con gái mà.
Dialogue: 0,0:18:31.26,0:18:32.26,Default,,0,0,0,,Còn đứa bé là con trai kia mà.
Dialogue: 0,0:18:32.51,0:18:33.86,Default,,0,0,0,,V-Vậy...
Dialogue: 0,0:18:34.13,0:18:34.88,Default,,0,0,0,,Reiri...
Dialogue: 0,0:18:36.00,0:18:36.60,Default,,0,0,0,,Eri...
Dialogue: 0,0:18:36.76,0:18:37.66,Default,,0,0,0,,Ariel...?
Dialogue: 0,0:18:39.00,0:18:39.98,Default,,0,0,0,,Ariel!
Dialogue: 0,0:18:42.62,0:18:44.43,Default,,0,0,0,,Thôi được rồi.
Dialogue: 0,0:18:49.99,0:18:53.33,Default,,0,0,0,,Con của họ hàng tôi, con bé biết dệt vải nữa đấy.
Dialogue: 0,0:19:02.43,0:19:05.38,Default,,0,0,0,,Sau cửa tiệm có một cái khung dệt bỏ hoang.
Dialogue: 0,0:19:05.78,0:19:07.23,Default,,0,0,0,,Thích dùng sao thì dùng.
Dialogue: 0,0:19:12.92,0:19:13.70,Default,,0,0,0,,Chờ ở đây nhé.
Dialogue: 0,0:19:17.23,0:19:18.79,Default,,0,0,0,,Con bé là người Iorph nhỉ.
Dialogue: 0,0:19:19.64,0:19:21.48,Default,,0,0,0,,Không qua mặt được Darel rồi.
Dialogue: 0,0:19:21.70,0:19:22.48,Default,,0,0,0,,Xin anh...
Dialogue: 0,0:19:26.15,0:19:28.46,Default,,0,0,0,,Vải do người Iorph dệt có giá rất cao.
Dialogue: 0,0:19:29.51,0:19:31.84,Default,,0,0,0,,Danh tính của nguồn tiền quý giá như thế...
Dialogue: 0,0:19:32.09,0:19:33.88,Default,,0,0,0,,tôi không tiết lộ ra ngoài đâu mà lo.
Dialogue: 0,0:19:35.04,0:19:36.18,Default,,0,0,0,,Cám ơn anh.
Dialogue: 0,0:19:36.50,0:19:39.37,Default,,0,0,0,,Có điều, con bé nhìn như khúc xương ấy.
Dialogue: 0,0:19:39.97,0:19:42.20,Default,,0,0,0,,Còn là tộc nhân Iorph nữa chứ.
Dialogue: 0,0:19:42.77,0:19:43.56,Default,,0,0,0,,Ừ nhỉ.
Dialogue: 0,0:19:44.17,0:19:46.60,Default,,0,0,0,,Chuyện từ giờ về sau thế nào thì tôi chẳng biết nữa.
Dialogue: 0,0:19:47.38,0:19:49.83,Default,,0,0,0,,Chẳng biết con bé sẽ đi nơi khác hay ở lại đây nữa.
Dialogue: 0,0:19:56.02,0:19:58.00,Default,,0,0,0,,Đây, phần của tuần này.
Dialogue: 0,0:19:58.06,0:20:00.13,Default,,0,0,0,,Cảm ơn cháu nhiều.
Dialogue: 0,0:20:02.24,0:20:06.06,Default,,0,0,0,,Vị của món phô mai do cháu làm khác lần đầu lắm đó.
Dialogue: 0,0:20:06.06,0:20:08.80,Default,,0,0,0,,Làm gì có! Tuần sau lại phiền bà nhé!
Dialogue: 0,0:20:09.02,0:20:11.62,Default,,0,0,0,,Khác lần thứ 2 luôn nè.
Dialogue: 0,0:20:11.62,0:20:13.06,Default,,0,0,0,,Cả tuần sau nữa luôn nhé!
Dialogue: 0,0:20:15.13,0:20:16.63,Default,,0,0,0,,Dù đã có tuổi rồi...
Dialogue: 0,0:20:16.77,0:20:19.47,Default,,0,0,0,,nhưng một mình nuôi con như cô cũng cực lắm đấy.
Dialogue: 0,0:20:20.37,0:20:21.44,Default,,0,0,0,,Cháu có hiểu không đấy?
Dialogue: 0,0:20:23.79,0:20:25.01,Default,,0,0,0,,Chồng của cô ấy..
Dialogue: 0,0:20:26.10,0:20:28.68,Default,,0,0,0,,bị một con Renato mắc bệnh Mắt đỏ sát hại.
Dialogue: 0,0:20:32.67,0:20:34.01,Default,,0,0,0,,Cháu không hiểu ạ.
Dialogue: 0,0:20:34.84,0:20:36.42,Default,,0,0,0,,Lại "Cháu không hiểu" à?
Dialogue: 0,0:20:37.40,0:20:39.51,Default,,0,0,0,,Mẹ là như thế nào?
Dialogue: 0,0:20:40.05,0:20:41.52,Default,,0,0,0,,Bởi con cũng...
Dialogue: 0,0:20:42.74,0:20:43.71,Default,,0,0,0,,không có.
Dialogue: 0,0:20:44.79,0:20:46.10,Default,,0,0,0,,Như thế này nè!
Dialogue: 0,0:22:01.46,0:22:02.26,Default,,0,0,0,,Đi được rồi!
Dialogue: 0,0:22:02.31,0:22:03.79,Default,,0,0,0,,Giỏi lắm, Ariel!
Dialogue: 0,0:22:04.91,0:22:05.81,Default,,0,0,0,,Ariel!
Dialogue: 0,0:22:09.52,0:22:10.54,Default,,0,0,0,,Giỏi thiệt đó!
Dialogue: 0,0:22:10.77,0:22:12.32,Default,,0,0,0,,Ariel giỏi quá!
Dialogue: 0,0:22:17.50,0:22:21.16,Default,,0,0,0,,Ra dáng một bà mẹ rồi đấy.
Dialogue: 0,0:22:23.56,0:22:25.59,Default,,0,0,0,,Cháu là... mẹ?
Dialogue: 0,0:22:27.49,0:22:29.77,Default,,0,0,0,,Làm gì có bà mẹ nào không đáng tin cậy thế này!
Dialogue: 0,0:22:30.70,0:22:33.59,Default,,0,0,0,,Mấy đứa dọn chuồng dê xong chưa đấy?
Dialogue: 0,0:22:33.81,0:22:34.96,Default,,0,0,0,,Chết thật, là mẹ!
Dialogue: 0,0:22:35.07,0:22:36.02,Default,,0,0,0,,Đi thôi, Deol!
Dialogue: 0,0:22:38.84,0:22:40.05,Default,,0,0,0,,Cho con xin lỗi!
Dialogue: 0,0:22:40.18,0:22:41.33,Default,,0,0,0,,Xin lỗi mẹ!
Dialogue: 0,0:22:41.78,0:22:43.26,Default,,0,0,0,,Tới đây, đưa mông ra!
Dialogue: 0,0:22:44.23,0:22:44.90,Default,,0,0,0,,Đau!
Dialogue: 0,0:22:45.20,0:22:46.23,Default,,0,0,0,,Đau!
Dialogue: 0,0:22:50.46,0:22:53.22,Default,,0,0,0,,Con nói "Mama" thử xem.
Dialogue: 0,0:22:56.30,0:22:57.97,Default,,0,0,0,,Nói dối! Vừa rồi là nói dối!
Dialogue: 0,0:22:58.84,0:22:59.68,Default,,0,0,0,,Mama...
Dialogue: 0,0:23:01.19,0:23:03.37,Default,,0,0,0,,Ariel, con vừa nói gì?
Dialogue: 0,0:23:06.69,0:23:07.64,Default,,0,0,0,,Nói lại lần nữa đi.
Dialogue: 0,0:23:08.88,0:23:10.68,Default,,0,0,0,,Một lần nữa thôi!
Dialogue: 0,0:23:18.26,0:23:21.75,Default,,0,0,0,,Lại thêm 1 con Renato mắc bệnh Mắt đỏ.
Dialogue: 0,0:23:23.20,0:23:24.48,Default,,0,0,0,,Nó bị trừ khử rồi ạ.
Dialogue: 0,0:23:24.69,0:23:26.95,Default,,0,0,0,,Xác của nó đã được cách ly, hoả táng,
Dialogue: 0,0:23:27.19,0:23:28.90,Default,,0,0,0,,và chôn xuống lòng đất ạ.
Dialogue: 0,0:23:29.31,0:23:31.48,Default,,0,0,0,,Ta có tổng cộng 5 con còn sống.
Dialogue: 0,0:23:31.75,0:23:34.04,Default,,0,0,0,,Ô, thật đau buồn làm sao!
Dialogue: 0,0:23:34.42,0:23:38.11,Default,,0,0,0,,Cho đến giờ, Mezarte có đủ khả năng để chinh phạt các quốc gia láng giềng...
Dialogue: 0,0:23:38.33,0:23:41.39,Default,,0,0,0,,là nhờ những con quái vật biết bay từ thời cổ xưa, Renato.
Dialogue: 0,0:23:41.96,0:23:45.18,Default,,0,0,0,,Nên là nếu Renato chết đi, thì thế cân bằng cũng sẽ không còn.
Dialogue: 0,0:23:46.55,0:23:49.03,Default,,0,0,0,,Để duy trì uy quyền vốn có của Mezarte,
Dialogue: 0,0:23:49.03,0:23:53.28,Default,,0,0,0,,chúng ta cần những sinh mệnh nằm ngoài nhận thức \Ncủa con người để thay thế cho Renato.
Dialogue: 0,0:23:53.43,0:23:54.85,Default,,0,0,0,,P-Phải rồi!
Dialogue: 0,0:23:55.20,0:23:56.96,Default,,0,0,0,,Chúng ta đã có được nó.
Dialogue: 0,0:23:57.13,0:23:58.64,Default,,0,0,0,,Dòng máu được chọn!
Dialogue: 0,0:23:59.13,0:24:01.92,Default,,0,0,0,,Izor, con nhỏ đó sao rồi?
Dialogue: 0,0:24:02.29,0:24:05.71,Default,,0,0,0,,Con nhỏ Iorph đó sẽ trở thành vợ của hoàng tử Hazel.
Dialogue: 0,0:24:07.75,0:24:10.00,Default,,0,0,0,,Nè, tại sao vậy hả?
Dialogue: 0,0:24:11.20,0:24:13.42,Default,,0,0,0,,Các ngươi đều có cánh,
Dialogue: 0,0:24:14.37,0:24:16.41,Default,,0,0,0,,vậy thì sao không bay khỏi đây?
Dialogue: 0,0:24:22.45,0:24:23.37,Default,,0,0,0,,Đồ thỏ đế!
Dialogue: 0,0:24:24.92,0:24:26.95,Default,,0,0,0,,Các ngươi đều đang chết dần.
Dialogue: 0,0:24:27.86,0:24:30.45,Default,,0,0,0,,Các ngươi sẽ bị những cảm xúc dồn nén bập bùng trong lồng ngực...
Dialogue: 0,0:24:31.22,0:24:32.16,Default,,0,0,0,,thiêu đốt...
Dialogue: 0,0:24:32.58,0:24:34.05,Default,,0,0,0,,rồi chết dần...
Dialogue: 0,0:24:35.27,0:24:38.13,Default,,0,0,0,,Leilia-sama, đức vua cho gọi Người.
Dialogue: 0,0:24:39.70,0:24:40.67,Default,,0,0,0,,Đợi ta một lát.
Dialogue: 0,0:24:42.57,0:24:45.32,Default,,0,0,0,,Leilia-sama, sao lúc nào Người cũng tới đây?
Dialogue: 0,0:24:47.14,0:24:49.05,Default,,0,0,0,,Vì nó giống tháp Hibiol.
Dialogue: 0,0:24:50.80,0:24:51.77,Default,,0,0,0,,Vậy à?
Dialogue: 0,0:25:08.34,0:25:09.12,Default,,0,0,0,,Xong rồi!
Dialogue: 0,0:25:09.38,0:25:10.57,Default,,0,0,0,,Viết vầy đúng hông?
Dialogue: 0,0:25:10.67,0:25:13.27,Default,,0,0,0,,Ừ, "Onora, chóng khỏe nhé!"
Dialogue: 0,0:25:15.79,0:25:17.75,Default,,0,0,0,,Ở nơi mẹ ra đời ấy,
Dialogue: 0,0:25:18.30,0:25:21.36,Default,,0,0,0,,người ta dùng vải thay vì câu chữ để bộc lộ cảm xúc.
Dialogue: 0,0:25:21.91,0:25:23.57,Default,,0,0,0,,Nơi mama ra đời?
Dialogue: 0,0:25:23.99,0:25:25.78,Default,,0,0,0,,Thế con ra đời ở đâu?
Dialogue: 0,0:25:26.84,0:25:28.68,Default,,0,0,0,,Mẹ Dita đã nói rằng.
Dialogue: 0,0:25:28.79,0:25:31.00,Default,,0,0,0,,Mama không giống người ta chút nào.
Dialogue: 0,0:25:33.14,0:25:35.15,Default,,0,0,0,,Ở nơi Ariel ra đời ấy,
Dialogue: 0,0:25:35.74,0:25:37.79,Default,,0,0,0,,trong bụng mấy người ở đó có thứ biết nói đó...
Dialogue: 0,0:25:38.14,0:25:39.59,Default,,0,0,0,,Lũ bọ ngọ nguậy nè!
Dialogue: 0,0:25:39.80,0:25:40.80,Default,,0,0,0,,Đến rồi!
Dialogue: 0,0:25:40.80,0:25:41.51,Default,,0,0,0,,Ngọ nguậy, ngọ nguậy nè!
Dialogue: 0,0:25:41.51,0:25:43.89,Default,,0,0,0,,Bụng nói bằng cách đánh rắm đấy!
Dialogue: 0,0:25:47.17,0:25:48.44,Default,,0,0,0,,Onora!
Dialogue: 0,0:25:49.18,0:25:50.72,Default,,0,0,0,,Làm nhẹ nhàng thôi nhé.
Dialogue: 0,0:25:55.64,0:25:57.08,Default,,0,0,0,,Tốt rồi ha, Onora?
Dialogue: 0,0:25:58.34,0:26:01.64,Default,,0,0,0,,Onora đã ở đây từ khi cha và mẹ kết hôn.
Dialogue: 0,0:26:02.50,0:26:05.62,Default,,0,0,0,,Nếu tính theo tuổi con người thì giờ nó tầm 90 rồi.
Dialogue: 0,0:26:16.87,0:26:19.69,Default,,0,0,0,,Mẹ của Ariel lạ thật đó.
Dialogue: 0,0:26:19.80,0:26:21.98,Default,,0,0,0,,Lúc nào cũng lấm la lấm lét.
Dialogue: 0,0:26:22.12,0:26:23.50,Default,,0,0,0,,Lạ gì mà lạ chứ!
Dialogue: 0,0:26:23.73,0:26:24.42,Default,,0,0,0,,Mama...
Dialogue: 0,0:26:25.16,0:26:26.20,Default,,0,0,0,,Mẹ là...
Dialogue: 0,0:26:26.98,0:26:27.67,Default,,0,0,0,,Tui...
Dialogue: 0,0:26:28.97,0:26:30.48,Sign,,0,0,0,,Ở Nhật, trẻ con thường dùng 僕 (boku) để xưng với nhau
Dialogue: 0,0:26:28.97,0:26:30.48,Default,,0,0,0,,Nó vẫn còn dùng từ "Tui" kìa.
Dialogue: 0,0:26:30.48,0:26:32.83,Default,,0,0,0,,Như con nít ấy! Cưng chưa kìa!
Dialogue: 0,0:26:32.95,0:26:34.80,Default,,0,0,0,,Ariel mới lạ đấy!
Dialogue: 0,0:26:35.46,0:26:38.21,Default,,0,0,0,,Con trai mà thích mẹ mới là lạ đấy.
Dialogue: 0,0:26:38.29,0:26:40.25,Default,,0,0,0,,Lạ gì mà lạ! Tui...
Dialogue: 0,0:26:41.57,0:26:43.33,Default,,0,0,0,,Tao ghét...!
Dialogue: 0,0:26:43.96,0:26:45.47,Default,,0,0,0,,Tao yêu mẹ mà.
Dialogue: 0,0:26:45.59,0:26:46.74,Default,,0,0,0,,Mày im đi!
Dialogue: 0,0:26:46.81,0:26:48.84,Default,,0,0,0,,Nếu là Dita thì tao ghét!
Dialogue: 0,0:26:55.69,0:26:57.56,Default,,0,0,0,,Có sao không vậy, Dita?
Dialogue: 0,0:27:04.79,0:27:05.96,Default,,0,0,0,,Chất lượng tốt đấy.
Dialogue: 0,0:27:09.41,0:27:10.96,Default,,0,0,0,,Đây, phần của tháng này.
Dialogue: 0,0:27:11.34,0:27:12.62,Default,,0,0,0,,Cám ơn bác.
Dialogue: 0,0:27:13.04,0:27:15.76,Default,,0,0,0,,À đúng rồi, cháu xem cái này đi.
Dialogue: 0,0:27:16.36,0:27:18.80,Default,,0,0,0,,Có người ở Hibiol đem đến.
Dialogue: 0,0:27:30.97,0:27:31.70,Default,,0,0,0,,Có chuyện gì vậy?
Dialogue: 0,0:27:32.73,0:27:34.06,Default,,0,0,0,,Tại lâu đài Mezarte,
Dialogue: 0,0:27:34.87,0:27:37.03,Default,,0,0,0,,hoàng tử sẽ gửi...
Dialogue: 0,0:27:37.86,0:27:38.88,Default,,0,0,0,,lời cầu hôn đến...
Dialogue: 0,0:27:40.50,0:27:41.82,Default,,0,0,0,,Lei... lia... xinh đẹp...
Dialogue: 0,0:27:43.17,0:27:44.40,Default,,0,0,0,,Này, Maquia!
Dialogue: 0,0:27:46.74,0:27:51.13,Default,,0,0,0,,Darel nói rằng cháu có thể mượn thuyền của ông ấy để đi.
Dialogue: 0,0:27:52.07,0:27:53.01,Default,,0,0,0,,Kia, con bé đó.
Dialogue: 0,0:27:53.23,0:27:56.22,Default,,0,0,0,,Cứ như mọi chuyện đã an bài sẵn vậy.
Dialogue: 0,0:27:57.94,0:27:59.93,Default,,0,0,0,,Nhưng còn Ariel thì sao?
Dialogue: 0,0:28:01.92,0:28:05.89,Default,,0,0,0,,Đưa một đứa trẻ đi cùng trong hành trình dài như vậy sẽ gian nan lắm đấy.
Dialogue: 0,0:28:06.75,0:28:09.48,Default,,0,0,0,,Hơn nữa, còn phải tính trước những tình huống có thể xảy ra.
Dialogue: 0,0:28:11.36,0:28:13.07,Default,,0,0,0,,Nếu ở đây thì cô có thể trông Ariel dùm cháu.
Dialogue: 0,0:28:13.81,0:28:15.16,Default,,0,0,0,,Mẹ!
Dialogue: 0,0:28:15.22,0:28:16.54,Default,,0,0,0,,Mẹ ơi!
Dialogue: 0,0:28:16.54,0:28:17.33,Default,,0,0,0,,Ariel!
Dialogue: 0,0:28:30.83,0:28:33.28,Default,,0,0,0,,Anh hai, đào sâu như vậy...
Dialogue: 0,0:28:33.52,0:28:34.15,Default,,0,0,0,,Lỡ đâu...
Dialogue: 0,0:28:34.57,0:28:36.19,Default,,0,0,0,,lỡ đâu Onora sống lại thì...
Dialogue: 0,0:28:36.19,0:28:36.64,Default,,0,0,0,,Đồ ngốc.
Dialogue: 0,0:28:37.79,0:28:39.90,Default,,0,0,0,,Đào nông quá thì lũ chó hoang nó bới lên đấy.
Dialogue: 0,0:28:40.94,0:28:41.45,Default,,0,0,0,,Nào.
Dialogue: 0,0:28:55.83,0:28:57.78,Default,,0,0,0,,Nếu phủ đất lên thì mình sẽ không được gặp nó nữa.
Dialogue: 0,0:28:58.16,0:29:00.35,Default,,0,0,0,,Con có thể gặp nó ở đây bất cứ lúc nào mà.
Dialogue: 0,0:29:01.14,0:29:03.24,Default,,0,0,0,,Nếu phủ đất lên thì sẽ không chơi cùng được nữa.
Dialogue: 0,0:29:03.81,0:29:05.30,Default,,0,0,0,,Vậy thì nhớ nói lời từ biệt cho đàng hoàng nhé.
Dialogue: 0,0:29:05.83,0:29:08.55,Default,,0,0,0,,Nó đã sống một đời yên bình không chút khổ đau mà.
Dialogue: 0,0:29:10.41,0:29:12.60,Default,,0,0,0,,Mọi người ai rồi cũng sẽ đi đến ngày này.
Dialogue: 0,0:29:13.44,0:29:17.89,Default,,0,0,0,,Chỉ là Onora đến ngày này sớm hơn chúng ta thôi.
Dialogue: 0,0:29:23.05,0:29:23.79,Default,,0,0,0,,Maquia!
Dialogue: 0,0:29:25.12,0:29:26.17,Default,,0,0,0,,Để con đuổi theo.
Dialogue: 0,0:29:32.37,0:29:33.84,Default,,0,0,0,,Mọi người rồi sẽ chết hết ư?
Dialogue: 0,0:29:35.52,0:29:36.48,Default,,0,0,0,,Cả mẹ ư?
Dialogue: 0,0:29:43.26,0:29:44.06,Default,,0,0,0,,Maquia!
Dialogue: 0,0:29:44.45,0:29:45.20,Default,,0,0,0,,Chờ đã!
Dialogue: 0,0:29:45.38,0:29:46.32,Default,,0,0,0,,Tớ bảo chờ đã mà!
Dialogue: 0,0:29:52.50,0:29:53.49,Default,,0,0,0,,Ariel...
Dialogue: 0,0:29:54.86,0:29:57.12,Default,,0,0,0,,mọi người...
Dialogue: 0,0:29:58.98,0:29:59.82,Default,,0,0,0,,nhất định...
Dialogue: 0,0:30:00.71,0:30:03.73,Default,,0,0,0,,sẽ đến ngày đó trước tớ!
Dialogue: 0,0:30:04.09,0:30:04.77,Default,,0,0,0,,Maquia...
Dialogue: 0,0:30:05.75,0:30:07.82,Default,,0,0,0,,Tớ không hiểu, nhưng mà...
Dialogue: 0,0:30:08.50,0:30:09.85,Default,,0,0,0,,Tớ hiểu chứ, nhưng mà...
Dialogue: 0,0:30:10.62,0:30:11.48,Default,,0,0,0,,Nhưng mà...
Dialogue: 0,0:30:12.58,0:30:14.89,Default,,0,0,0,,Cái thứ tự đó sao mà chả được chứ!
Dialogue: 0,0:30:16.74,0:30:17.70,Default,,0,0,0,,Đừng có khóc!
Dialogue: 0,0:30:19.47,0:30:20.86,Default,,0,0,0,,Lang cũng khóc kia mà!
Dialogue: 0,0:30:22.18,0:30:24.77,Default,,0,0,0,,Cậu là mẹ của Ariel, phải không nào?
Dialogue: 0,0:30:26.37,0:30:28.66,Default,,0,0,0,,Là mẹ thì không được khóc!
Dialogue: 0,0:30:28.82,0:30:29.99,Default,,0,0,0,,Mẹ của tớ...
Dialogue: 0,0:30:31.80,0:30:34.26,Default,,0,0,0,,Đã là mẹ thì nhất định không có chuyện khóc lóc!
Dialogue: 0,0:30:39.15,0:30:40.01,Default,,0,0,0,,Tớ không khóc đâu mà...
Dialogue: 0,0:30:41.02,0:30:42.36,Default,,0,0,0,,Ừ, đừng khóc.
Dialogue: 0,0:30:45.09,0:30:46.18,Default,,0,0,0,,Đừng khóc mà...
Dialogue: 0,0:30:47.25,0:30:49.06,Default,,0,0,0,,Ừ, tớ sẽ không khóc.
Dialogue: 0,0:30:53.26,0:30:54.06,Default,,0,0,0,,Ngủ ngon.
Dialogue: 0,0:30:54.29,0:30:55.10,Default,,0,0,0,,Ngủ ngon.
Dialogue: 0,0:30:59.62,0:31:00.39,Default,,0,0,0,,Ariel!
Dialogue: 0,0:31:08.26,0:31:09.59,Default,,0,0,0,,Con chờ mẹ đấy à?
Dialogue: 0,0:31:10.56,0:31:11.80,Default,,0,0,0,,Ngủ cho đủ giấc nghe con.
Dialogue: 0,0:31:19.22,0:31:20.56,Default,,0,0,0,,Con nặng hơn rồi ha.
Dialogue: 0,0:31:21.20,0:31:21.85,Default,,0,0,0,,Nhưng mà...
Dialogue: 0,0:31:24.30,0:31:26.13,Default,,0,0,0,,Quả nhiên vẫn là mùi của vầng mặt trời.
Dialogue: 0,0:31:27.09,0:31:28.88,Default,,0,0,0,,Mẹ sẽ không khóc đâu.
Dialogue: 0,0:31:29.66,0:31:31.44,Default,,0,0,0,,Vì mẹ là mẹ của Ariel.
Dialogue: 0,0:31:32.50,0:31:35.89,Default,,0,0,0,,Kể từ giờ, chúng ta sẽ mãi bên nhau.
Dialogue: 0,0:31:38.06,0:31:39.47,Default,,0,0,0,,Xin lỗi vì chuyện lần trước nhé...
Dialogue: 0,0:31:39.54,0:31:40.84,Default,,0,0,0,,Xin lỗi vì chuyện lần trước nhé...
Dialogue: 0,0:31:41.02,0:31:42.16,Default,,0,0,0,,Xin lỗi vì chuyện lần trước nhé...
Dialogue: 0,0:31:42.48,0:31:43.60,Default,,0,0,0,,Xin lỗi vì chuyện lần trước nhé...
Dialogue: 0,0:31:44.06,0:31:45.28,Default,,0,0,0,,Xin lỗi vì chuyện lần trước nhé...
Dialogue: 0,0:31:47.22,0:31:48.27,Default,,0,0,0,,Xin lỗi vì chuyện lần trước nhé...
Dialogue: 0,0:31:48.48,0:31:49.65,Default,,0,0,0,,Xin lỗi vì chuyện lần trước nhé...
Dialogue: 0,0:31:51.36,0:31:52.93,Default,,0,0,0,,Nếu tìm Ariel, thì nó không còn ở đây đâu.
Dialogue: 0,0:32:03.30,0:32:04.89,Default,,0,0,0,,Anh chấp nhận nhìn họ đi như vậy à?
Dialogue: 0,0:32:22.93,0:32:24.17,Default,,0,0,0,,Con muốn ra bên ngoài!
Dialogue: 0,0:32:24.27,0:32:26.31,Default,,0,0,0,,Này! Đã bảo đừng có làm vậy mà!
Dialogue: 0,0:32:26.40,0:32:27.43,Default,,0,0,0,,Ariel!
Dialogue: 0,0:32:28.02,0:32:30.29,Default,,0,0,0,,Thật là, con đã hứa rồi mà!
Dialogue: 0,0:32:30.39,0:32:31.88,Default,,0,0,0,,"Con sẽ ngồi yên cho mẹ!" mà.
Dialogue: 0,0:32:32.78,0:32:34.34,Default,,0,0,0,,X-Xin lỗi.
Dialogue: 0,0:32:37.42,0:32:38.28,Default,,0,0,0,,Maquia?
Dialogue: 0,0:32:42.15,0:32:43.85,Default,,0,0,0,,Cậu vẫn còn sống, Maquia!
Dialogue: 0,0:32:44.46,0:32:47.04,Default,,0,0,0,,Cậu vẫn còn sống, Krim!
Dialogue: 0,0:32:54.37,0:32:58.88,Default,,0,0,0,,Thứ mà bọn Mezarte nhắm đến là dòng máu\N trường thọ của người Iorph.
Dialogue: 0,0:32:59.81,0:33:01.16,Default,,0,0,0,,Ngôi làng đã bị tấn công...
Dialogue: 0,0:33:02.27,0:33:03.04,Default,,0,0,0,,Còn Leilia đã...
Dialogue: 0,0:33:04.17,0:33:06.83,Default,,0,0,0,,Mẹ, Leilia là ai?
Dialogue: 0,0:33:07.22,0:33:08.98,Default,,0,0,0,,Cậu để nó gọi mình là mẹ ư?
Dialogue: 0,0:33:09.87,0:33:11.00,Default,,0,0,0,,A, không phải!
Dialogue: 0,0:33:11.10,0:33:13.02,Default,,0,0,0,,Chuyện gọi này gọi nọ không phải...
Dialogue: 0,0:33:13.29,0:33:14.49,Default,,0,0,0,,Tớ không giận đâu.
Dialogue: 0,0:33:15.16,0:33:16.12,Default,,0,0,0,,Đâu thể trách cậu được.
Dialogue: 0,0:33:17.22,0:33:19.89,Default,,0,0,0,,Nhưng mà, lúc nào trưởng lão cũng nói rằng...
Dialogue: 0,0:33:22.13,0:33:24.26,Default,,0,0,0,,Ừ, tớ không có quên.
Dialogue: 0,0:33:25.61,0:33:26.72,Default,,0,0,0,,Thế thì tốt.
Dialogue: 0,0:33:58.16,0:34:02.01,Default,,0,0,0,,Sáng ngày mai sẽ diễn ra cuộc diễu hành mừng hôn lễ của hoàng tử.
Dialogue: 0,0:34:03.13,0:34:05.29,Default,,0,0,0,,Đội diễu hành của hoàng tử sẽ xuất phát từ hoàng cnug...
Dialogue: 0,0:34:05.69,0:34:09.73,Default,,0,0,0,,sau đó qua cầu để gặp đoàn diễu hành của Leilia đến từ dinh thự.
Dialogue: 0,0:34:10.32,0:34:12.93,Default,,0,0,0,,Tại đây, bọn mình sẽ tấn công Renato chở hoàng tử...
Dialogue: 0,0:34:13.26,0:34:14.25,Default,,0,0,0,,Gây náo loạn.
Dialogue: 0,0:34:14.66,0:34:17.09,Default,,0,0,0,,Như thế sẽ khiến tuyến phòng vệ ở dinh thự mỏng ra.
Dialogue: 0,0:34:17.99,0:34:19.67,Default,,0,0,0,,Rồi bọn mình sẽ đoạt lại Leilia.
Dialogue: 0,0:34:21.80,0:34:23.54,Default,,0,0,0,,Con cũng muốn xem diễu hành.
Dialogue: 0,0:34:24.20,0:34:26.88,Default,,0,0,0,,Mẹ xin lỗi, để lần tới con nhé.
Dialogue: 0,0:34:27.97,0:34:31.12,Sign,,0,0,0,,{\be2}Đoạn này Ariel đổi ngôi xưng từ 僕 (Boku) sang 俺 (Ore) để ra vẻ người lớn
Dialogue: 0,0:34:27.97,0:34:28.69,Default,,0,0,0,,Con...
Dialogue: 0,0:34:29.57,0:34:31.12,Default,,0,0,0,,Con muốn về nhà!
Dialogue: 0,0:34:31.57,0:34:32.48,Default,,0,0,0,,Ariel?
Dialogue: 0,0:34:34.15,0:34:37.70,Default,,0,0,0,,Khi ở đây, mẹ chẳng giống mẹ chút nào!
Dialogue: 0,0:34:45.33,0:34:46.28,Default,,0,0,0,,Ariel.
Dialogue: 0,0:34:47.00,0:34:48.84,Default,,0,0,0,,Lũ bọ ngọ nguậy nè...
Dialogue: 0,0:34:48.84,0:34:50.18,Default,,0,0,0,,Đến rồi!
Dialogue: 0,0:34:50.18,0:34:53.88,Default,,0,0,0,,Ngọ nguậy, ngọ nguậy, ngọ nguậy...!
Dialogue: 0,0:35:16.00,0:35:19.14,Default,,0,0,0,,Mại dzô, hàng tốt mừng ngày lành đây, mại dzô bà con!
Dialogue: 0,0:35:26.04,0:35:32.10,Default,,0,0,0,,Kể từ giờ, dòng máu Iorph chính thức được đón nhận vào hoàng tộc.
Dialogue: 0,0:35:32.79,0:35:34.32,Default,,0,0,0,,Renato và Iorph.
Dialogue: 0,0:35:35.14,0:35:37.79,Default,,0,0,0,,Những huyền thoại cổ xưa tồn tại cho đến ngày nay.
Dialogue: 0,0:35:38.42,0:35:41.04,Default,,0,0,0,,Cả hai giờ đã thuộc về chúng ta!
Dialogue: 0,0:35:41.84,0:35:43.96,Default,,0,0,0,,Chúng ta, những người được thánh thần lựa chọn...
Dialogue: 0,0:35:44.32,0:35:46.85,Default,,0,0,0,,sẽ không còn phải sợ bất kỳ kẻ thù nào nữa!
Dialogue: 0,0:35:51.83,0:35:56.35,Default,,0,0,0,,Và, lễ thành hôn giữa hoàng tử Hazel và công chúa Leilia...
Dialogue: 0,0:35:56.77,0:36:01.54,Default,,0,0,0,,sẽ đánh dấu sự ra đời của một huyền thoại mới tại Mezarte!
Dialogue: 0,0:37:15.62,0:37:16.33,Default,,0,0,0,,Đó là...!
Dialogue: 0,0:37:31.83,0:37:32.89,Default,,0,0,0,,Có thích khách ư?!
Dialogue: 0,0:37:33.06,0:37:34.01,Default,,0,0,0,,Rốt cuộc là chuyện gì?!
Dialogue: 0,0:37:42.07,0:37:43.90,Default,,0,0,0,,Leilia... Leilia....
Dialogue: 0,0:37:53.10,0:37:54.74,Default,,0,0,0,,Úi, xin lỗi nhé!
Dialogue: 0,0:38:02.59,0:38:03.51,Default,,0,0,0,,Leilia!
Dialogue: 0,0:38:06.43,0:38:07.24,Default,,0,0,0,,Maquia.
Dialogue: 0,0:38:08.21,0:38:09.46,Default,,0,0,0,,Tại sao cậu lại ở đây?
Dialogue: 0,0:38:10.26,0:38:11.70,Default,,0,0,0,,Krim cũng đến đấy.
Dialogue: 0,0:38:13.11,0:38:14.13,Default,,0,0,0,,Krim?
Dialogue: 0,0:38:14.25,0:38:15.57,Default,,0,0,0,,Ừ, đi thôi!
Dialogue: 0,0:38:15.79,0:38:17.47,Default,,0,0,0,,Mọi người đang chờ Leilia đấy!
Dialogue: 0,0:38:18.26,0:38:18.99,Default,,0,0,0,,Leilia?
Dialogue: 0,0:38:20.47,0:38:22.46,Default,,0,0,0,,Không được nữa rồi...
Dialogue: 0,0:38:23.43,0:38:24.23,Default,,0,0,0,,Tại sao?
Dialogue: 0,0:38:25.84,0:38:26.98,Default,,0,0,0,,Tớ không thể bỏ trốn được.
Dialogue: 0,0:38:27.95,0:38:28.97,Default,,0,0,0,,Tại sao?
Dialogue: 0,0:38:29.22,0:38:30.81,Default,,0,0,0,,Leilia nhanh nhẹn lắm kia mà!
Dialogue: 0,0:38:31.08,0:38:32.05,Default,,0,0,0,,Đúng rồi!
Dialogue: 0,0:38:32.18,0:38:34.58,Default,,0,0,0,,Hàng rào cao vời vợi mà cậu còn nhảy qua được...
Dialogue: 0,0:38:44.49,0:38:46.74,Default,,0,0,0,,Tớ không thể gặp Krim nữa đâu...
Dialogue: 0,0:38:49.13,0:38:50.12,Default,,0,0,0,,Không thể nào...
Dialogue: 0,0:38:50.82,0:38:51.70,Default,,0,0,0,,Chuyện đó...
Dialogue: 0,0:38:51.70,0:38:52.87,Default,,0,0,0,,Leilia-sama!
Dialogue: 0,0:38:54.91,0:38:56.16,Default,,0,0,0,,Đi mau, Maquia!
Dialogue: 0,0:38:57.21,0:38:58.69,Default,,0,0,0,,Nhưng mà, Leilia!
Dialogue: 0,0:38:59.49,0:39:00.20,Default,,0,0,0,,Đi mau!
Dialogue: 0,0:39:00.47,0:39:02.74,Default,,0,0,0,,Không sao đâu! Tớ có thể bay mà!
Dialogue: 0,0:39:03.84,0:39:04.72,Default,,0,0,0,,Đừng hòng thoát!
Dialogue: 0,0:39:16.57,0:39:17.40,Default,,0,0,0,,Leilia-sama!
Dialogue: 0,0:39:19.02,0:39:19.44,Default,,0,0,0,,Đuổi theo!
Dialogue: 0,0:39:19.44,0:39:19.94,Default,,0,0,0,,Khoan!
Dialogue: 0,0:39:20.69,0:39:22.24,Default,,0,0,0,,Nếu các người dám động vào cậu ấy...
Dialogue: 0,0:39:33.74,0:39:34.76,Default,,0,0,0,,Leilia-sama.
Dialogue: 0,0:39:43.12,0:39:43.95,Default,,0,0,0,,Mình...
Dialogue: 0,0:39:45.57,0:39:46.21,Default,,0,0,0,,có thể bay mà.
Dialogue: 0,0:39:53.82,0:39:55.49,Default,,0,0,0,,Đứa bé đã lớn rồi nhỉ?
Dialogue: 0,0:39:57.01,0:39:59.20,Default,,0,0,0,,Nếu còn sống thì chắc cũng 6 tuổi rồi nhỉ.
Dialogue: 0,0:40:00.70,0:40:02.65,Default,,0,0,0,,Sao, thế giới bên ngoài thế nào?
Dialogue: 0,0:40:04.66,0:40:06.74,Default,,0,0,0,,Anh cũng là người Iorph...?
Dialogue: 0,0:40:07.15,0:40:08.52,Default,,0,0,0,,Một nửa thôi.
Dialogue: 0,0:40:09.38,0:40:10.21,Default,,0,0,0,,Racina...!
Dialogue: 0,0:40:10.78,0:40:11.72,Default,,0,0,0,,Cô có biết...
Dialogue: 0,0:40:11.99,0:40:15.56,Default,,0,0,0,,tại sao mọi người đều bị cấm ra khỏi làng không?
Dialogue: 0,0:40:16.96,0:40:21.10,Default,,0,0,0,,Vì ai cũng biết số mệnh đang chờ đợi họ phía trước.
Dialogue: 0,0:40:22.35,0:40:23.86,Default,,0,0,0,,Dù họ không muốn...
Dialogue: 0,0:40:23.95,0:40:27.50,Default,,0,0,0,,nhưng rồi cũng sẽ bị kỳ thị, lợi dụng,
Dialogue: 0,0:40:28.47,0:40:31.01,Default,,0,0,0,,cuối cùng là bị ghê tởm, rồi bị trừ khử.
Dialogue: 0,0:40:32.28,0:40:32.91,Default,,0,0,0,,Phải.
Dialogue: 0,0:40:33.36,0:40:38.53,Default,,0,0,0,,Tộc Ly biệt luôn phải đương đầu với sự chia cắt.
Dialogue: 0,0:40:43.27,0:40:45.02,Default,,0,0,0,,Chúc cô có một cuộc đời như ý muốn nhé.
Dialogue: 0,0:41:04.53,0:41:06.18,Default,,0,0,0,,Krim, vết thương...
Dialogue: 0,0:41:12.53,0:41:14.28,Default,,0,0,0,,Hay là cậu cởi áo khoác ra đi?
Dialogue: 0,0:41:19.62,0:41:22.15,Default,,0,0,0,,Đứa trẻ... là thế nào?
Dialogue: 0,0:41:23.88,0:41:26.09,Default,,0,0,0,,Làm mẹ... là như thế nào...?
Dialogue: 0,0:41:28.74,0:41:31.79,Default,,0,0,0,,Tớ còn không biết mình có phải là mẹ không nữa.
Dialogue: 0,0:41:34.16,0:41:35.40,Default,,0,0,0,,Những thứ tớ không biết...
Dialogue: 0,0:41:35.80,0:41:37.33,Default,,0,0,0,,đều được Mido chỉ bảo cả.
Dialogue: 0,0:41:38.56,0:41:40.00,Default,,0,0,0,,Thằng bé hay giúp tớ,
Dialogue: 0,0:41:40.55,0:41:42.32,Default,,0,0,0,,cảm giác cứ như có một người em trai vậy,
Dialogue: 0,0:41:43.44,0:41:45.84,Default,,0,0,0,,có điều, tớ lại thấy hơi khác.
Dialogue: 0,0:41:47.46,0:41:51.12,Default,,0,0,0,,Khi Ariel cười, tớ cảm thấy rất vui.
Dialogue: 0,0:41:52.08,0:41:52.85,Default,,0,0,0,,Nên là...
Dialogue: 0,0:41:53.49,0:41:56.79,Default,,0,0,0,,Nếu ở bên tớ mà Ariel có thể cười,
Dialogue: 0,0:41:57.54,0:41:59.58,Default,,0,0,0,,thì tớ sẽ ở bên thằng bé mãi mãi.
Dialogue: 0,0:41:59.58,0:42:00.70,Default,,0,0,0,,Câu chuyện lạ thật!
Dialogue: 0,0:42:04.15,0:42:06.17,Default,,0,0,0,,Ariel sẽ chết trước chúng ta cơ mà.
Dialogue: 0,0:42:08.37,0:42:09.07,Default,,0,0,0,,Ariel sẽ...
Dialogue: 0,0:42:10.02,0:42:11.80,Default,,0,0,0,,khiến cậu phải cô đơn đấy, Maquia.
Dialogue: 0,0:42:17.50,0:42:18.56,Default,,0,0,0,,Không được làm mẹ tôi khóc!
Dialogue: 0,0:42:18.56,0:42:19.82,Default,,0,0,0,,Không phải đâu, Ariel!
Dialogue: 0,0:42:19.28,0:42:22.07,Default,,0,0,0,,Không được làm mẹ tôi khóc!
Dialogue: 0,0:42:22.07,0:42:23.89,Default,,0,0,0,,Ariel, thôi đi!
Dialogue: 0,0:42:24.67,0:42:25.57,Default,,0,0,0,,Cậu có bảo vệ được không?
Dialogue: 0,0:42:27.57,0:42:30.56,Default,,0,0,0,,Những thứ mà cậu trân trọng ấy.
Dialogue: 0,0:42:51.95,0:42:55.33,Italics,,0,0,0,,"Bọn tớ sẽ ở lại Mezarte để tìm cách cứu Leilia.
Dialogue: 0,0:42:56.49,0:42:58.65,Italics,,0,0,0,,Cậu còn có con nên chỉ tổ cản đường thôi.
Dialogue: 0,0:43:00.18,0:43:02.09,Italics,,0,0,0,,Nên là, Maquia...
Dialogue: 0,0:43:03.32,0:43:04.16,Italics,,0,0,0,,Tạm biệt cậu!"
Dialogue: 0,0:43:07.36,0:43:08.71,Default,,0,0,0,,Chúng ta sẽ trở về nhà hở mẹ?
Dialogue: 0,0:43:09.75,0:43:11.68,Default,,0,0,0,,Mình không trở về nhà nữa.
Dialogue: 0,0:43:12.46,0:43:13.39,Default,,0,0,0,,Còn mọi người?
Dialogue: 0,0:43:15.68,0:43:18.69,Default,,0,0,0,,Hai người chúng ta sẽ đến một nơi khác.
Dialogue: 0,0:43:19.54,0:43:20.77,Default,,0,0,0,,Nơi khác...
Dialogue: 0,0:43:21.12,0:43:23.93,Default,,0,0,0,,là nơi không có Mido với anh Lang hở mẹ?
Dialogue: 0,0:43:25.89,0:43:26.81,Default,,0,0,0,,Mẹ xin lỗi nhé.
Dialogue: 0,0:43:27.21,0:43:29.57,Default,,0,0,0,,Bắt con phải từ giã mọi người sớm thế.
Dialogue: 0,0:43:30.70,0:43:32.89,Default,,0,0,0,,Chỉ cần mẹ ở bên con là đủ!
Dialogue: 0,0:43:33.98,0:43:38.16,Default,,0,0,0,,Ừm. Mẹ cũng chỉ cần Ariel ở bên thôi.
Dialogue: 0,0:43:39.16,0:43:40.35,Default,,0,0,0,,Không được.
Dialogue: 0,0:43:40.81,0:43:42.44,Default,,0,0,0,,Cô có lý do gì phải không?
Dialogue: 0,0:43:42.72,0:43:46.35,Default,,0,0,0,,Gây ra đủ thứ chuyện rồi bỏ trốn, tôi chịu quá đủ rồi.
Dialogue: 0,0:43:49.22,0:43:50.08,Default,,0,0,0,,Ariel!
Dialogue: 0,0:43:52.02,0:43:52.85,Default,,0,0,0,,Xin lỗi ông!
Dialogue: 0,0:43:53.46,0:43:55.21,Default,,0,0,0,,Này! Đứng lại!
Dialogue: 0,0:43:55.42,0:43:56.32,Default,,0,0,0,,Ranh con!
Dialogue: 0,0:43:57.41,0:43:59.74,Default,,0,0,0,,Mẹ sẽ đi một vòng xem thử,
Dialogue: 0,0:44:00.10,0:44:01.71,Default,,0,0,0,,con về phòng trọ chờ mẹ nhé.
Dialogue: 0,0:44:03.25,0:44:03.84,Default,,0,0,0,,Hông chịu!
Dialogue: 0,0:44:04.26,0:44:05.95,Default,,0,0,0,,Chờ mẹ nhé, xin con.
Dialogue: 0,0:44:11.87,0:44:13.32,Default,,0,0,0,,Cảm ơn chị nhiều lắm!
Dialogue: 0,0:44:13.77,0:44:16.23,Default,,0,0,0,,Quán của tôi chuyên về rượu...
Dialogue: 0,0:44:16.43,0:44:18.10,Default,,0,0,0,,nên công việc thường là vào ban đêm đấy.
Dialogue: 0,0:44:18.30,0:44:19.02,Default,,0,0,0,,Có làm được không?
Dialogue: 0,0:44:20.32,0:44:21.94,Default,,0,0,0,,Làm đêm ạ...?
Dialogue: 0,0:44:22.30,0:44:23.44,Default,,0,0,0,,Có vấn đề gì à?
Dialogue: 0,0:44:25.03,0:44:26.67,Default,,0,0,0,,Con của tôi...
Dialogue: 0,0:44:27.27,0:44:29.03,Default,,0,0,0,,vẫn còn nhỏ.
Dialogue: 0,0:44:30.98,0:44:33.50,Default,,0,0,0,,Cô nhân viên vừa nghỉ việc cũng y vậy.
Dialogue: 0,0:44:33.96,0:44:36.38,Default,,0,0,0,,Còn trẻ mà chẳng chịu suy nghĩ gì cả.
Dialogue: 0,0:44:36.81,0:44:37.63,Default,,0,0,0,,K-Không phải...
Dialogue: 0,0:44:38.46,0:44:40.22,Default,,0,0,0,,Không phải? Không phải chỗ nào?
Dialogue: 0,0:44:40.68,0:44:42.89,Default,,0,0,0,,Rằng cô không nhận thức được mình là mẹ?
Dialogue: 0,0:44:44.11,0:44:44.96,Default,,0,0,0,,Xin lỗi nhé.
Dialogue: 0,0:44:45.66,0:44:48.66,Default,,0,0,0,,Chẳng ai nhận người như thế vào làm đâu.
Dialogue: 0,0:45:04.30,0:45:05.55,Default,,0,0,0,,Mẹ về rồi!
Dialogue: 0,0:45:07.52,0:45:08.36,Default,,0,0,0,,Mẹ về rồi.
Dialogue: 0,0:45:11.28,0:45:12.85,Default,,0,0,0,,Mẹ, coi nè!
Dialogue: 0,0:45:12.97,0:45:14.46,Default,,0,0,0,,Con dệt được Hibiol...
Dialogue: 0,0:45:20.45,0:45:22.16,Default,,0,0,0,,Đừng khiến mẹ bận thêm con nhé...
Dialogue: 0,0:45:23.77,0:45:25.61,Default,,0,0,0,,Sao con lại tự tiện lấy cái này ra phá hả?
Dialogue: 0,0:45:28.57,0:45:30.36,Default,,0,0,0,,Nè mẹ, coi nè...
Dialogue: 0,0:45:30.36,0:45:32.44,Default,,0,0,0,,Sao con không chịu nghe lời mẹ vậy hả?!
Dialogue: 0,0:45:33.06,0:45:33.81,Default,,0,0,0,,Sao...?!
Dialogue: 0,0:45:34.11,0:45:35.51,Default,,0,0,0,,Sao hồi chiều con lại...
Dialogue: 0,0:45:36.04,0:45:40.08,Default,,0,0,0,,Nếu mẹ không đi làm thì sao có cái để ăn hả?!
Dialogue: 0,0:45:40.69,0:45:41.65,Default,,0,0,0,,Mẹ...
Dialogue: 0,0:45:41.72,0:45:43.33,Default,,0,0,0,,Sao con cứ gây rắc rối cho mẹ vậy hả...?
Dialogue: 0,0:45:44.70,0:45:45.67,Default,,0,0,0,,Tại sao...?
Dialogue: 0,0:45:47.06,0:45:49.42,Default,,0,0,0,,Lũ bọ ngọ nguậy nè!
Dialogue: 0,0:45:49.56,0:45:52.58,Default,,0,0,0,,Ngọ nguậy ngọ nguậy...!
Dialogue: 0,0:45:53.12,0:45:55.42,Default,,0,0,0,,Mẹ đi mua đồ ăn tối đây.
Dialogue: 0,0:46:00.20,0:46:01.13,Default,,0,0,0,,Ariel!
Dialogue: 0,0:46:09.74,0:46:12.38,Default,,0,0,0,,Mình... không giống mẹ chút nào...
Dialogue: 0,0:46:13.36,0:46:15.15,Default,,0,0,0,,Mình còn không biết...
Dialogue: 0,0:46:15.95,0:46:17.20,Default,,0,0,0,,thế nào là làm mẹ.
Dialogue: 0,0:46:18.33,0:46:20.84,Default,,0,0,0,,Mình chỉ biết bắt chước...
Dialogue: 0,0:46:21.99,0:46:23.68,Default,,0,0,0,,bắt chước Mido mà thôi!
Dialogue: 0,0:46:24.66,0:46:26.09,Flashback,,0,0,0,,Đừng đem lòng yêu bất kỳ ai.
Dialogue: 0,0:46:27.06,0:46:30.41,Flashback,,0,0,0,,Khi đã yêu, thì con sẽ trở thành kẻ cô độc thực sự.
Dialogue: 0,0:46:32.22,0:46:33.17,Default,,0,0,0,,Kẻ cô độc...
Dialogue: 0,0:46:34.78,0:46:35.70,Default,,0,0,0,,thực sự...?
Dialogue: 0,0:46:49.42,0:46:51.85,Italics,,0,0,0,,Mẹ...
Dialogue: 0,0:46:53.70,0:46:54.74,Default,,0,0,0,,Mẹ...
Dialogue: 0,0:47:09.56,0:47:10.59,Default,,0,0,0,,Ariel!
Dialogue: 0,0:47:15.87,0:47:16.80,Default,,0,0,0,,Ariel!
Dialogue: 0,0:47:18.20,0:47:20.25,Default,,0,0,0,,Con đi đâu rồi?
Dialogue: 0,0:47:20.36,0:47:21.30,Default,,0,0,0,,Ariel!
Dialogue: 0,0:47:25.20,0:47:26.19,Default,,0,0,0,,Ariel!
Dialogue: 0,0:47:26.19,0:47:26.94,Default,,0,0,0,,Mẹ!
Dialogue: 0,0:47:28.51,0:47:29.27,Default,,0,0,0,,Ariel!
Dialogue: 0,0:47:35.90,0:47:37.10,Default,,0,0,0,,Lừa được mẹ rồi!
Dialogue: 0,0:47:38.26,0:47:40.40,Default,,0,0,0,,Mẹ tưởng đó là bộ da của con phải không?
Dialogue: 0,0:47:46.62,0:47:47.66,Default,,0,0,0,,Bộ da...
Dialogue: 0,0:47:47.96,0:47:49.70,Default,,0,0,0,,Mẹ cười rồi!
Dialogue: 0,0:47:51.08,0:47:51.94,Default,,0,0,0,,Ariel!
Dialogue: 0,0:47:55.53,0:47:56.30,Default,,0,0,0,,Đồ ngốc này.
Dialogue: 0,0:47:58.14,0:47:59.05,Default,,0,0,0,,Mẹ?
Dialogue: 0,0:48:00.40,0:48:04.90,Default,,0,0,0,,Phải chi con đừng lớn nữa thì tốt quá.
Dialogue: 0,0:48:06.37,0:48:07.06,Default,,0,0,0,,Hông được!
Dialogue: 0,0:48:09.73,0:48:13.02,Default,,0,0,0,,Nếu con không lớn thì làm sao bảo vệ mẹ được!
Dialogue: 0,0:48:18.61,0:48:20.18,Default,,0,0,0,,Mẹ lại khóc rồi.
Dialogue: 0,0:48:22.70,0:48:23.94,Default,,0,0,0,,Mẹ không khóc nữa đâu!
Dialogue: 0,0:48:24.55,0:48:26.36,Default,,0,0,0,,Bởi vì mẹ là mẹ của con mà!
Dialogue: 0,0:48:30.26,0:48:31.42,Default,,0,0,0,,Hứa rồi nhá.
Dialogue: 0,0:48:41.78,0:48:43.81,Default,,0,0,0,,Ariel cũng hứa nhé.
Dialogue: 0,0:48:44.24,0:48:45.68,Default,,0,0,0,,Ưm, con hứa!
Dialogue: 0,0:48:46.64,0:48:49.14,Default,,0,0,0,,Con sẽ bảo vệ mẹ!
Dialogue: 0,0:49:04.94,0:49:06.85,Default,,0,0,0,,Đúng rồi, từ từ thôi.
Dialogue: 0,0:49:30.67,0:49:31.98,Default,,0,0,0,,Đây, xong rồi!
Dialogue: 0,0:49:32.55,0:49:33.51,Default,,0,0,0,,Maquia!
Dialogue: 0,0:49:34.18,0:49:34.79,Default,,0,0,0,,Vâng!
Dialogue: 0,0:49:38.48,0:49:40.83,Default,,0,0,0,,Phải bắt cậu trả nợ lần trước mới được.
Dialogue: 0,0:49:41.17,0:49:43.41,Default,,0,0,0,,Gì đây? Tính tia em nào à?
Dialogue: 0,0:49:43.41,0:49:45.23,Default,,0,0,0,,Tôi có nói thế đâu! Đừng có giỡn nữa!
Dialogue: 0,0:49:46.82,0:49:49.00,Default,,0,0,0,,Chỉ người có kinh nghiệm mới làm được cái góc này thôi.
Dialogue: 0,0:49:53.97,0:49:56.27,Default,,0,0,0,,Vậy nên tôi mới bảo cậu đừng có làm nữa đó.
Dialogue: 0,0:49:56.53,0:49:58.98,Default,,0,0,0,,Cứ tưởng mọi chuyện sẽ trót lọt chứ.
Dialogue: 0,0:49:59.25,0:50:00.53,Default,,0,0,0,,Chào mừng quý khách!
Dialogue: 0,0:50:04.89,0:50:07.04,Default,,0,0,0,,Maquia, cho 3 Cheruby!
Dialogue: 0,0:50:07.20,0:50:07.92,Default,,0,0,0,,Vâng!
Dialogue: 0,0:50:09.46,0:50:10.37,Default,,0,0,0,,Có ngay!
Dialogue: 0,0:50:10.47,0:50:11.68,Default,,0,0,0,,Cho tôi nữa nhé.
Dialogue: 0,0:50:11.78,0:50:12.44,Default,,0,0,0,,Vâng...
Dialogue: 0,0:50:13.95,0:50:15.89,Default,,0,0,0,,Nè, cô em đó nhìn ngọt nước đấy chứ.
Dialogue: 0,0:50:17.46,0:50:18.55,Default,,0,0,0,,Thế à?
Dialogue: 0,0:50:19.85,0:50:22.88,Default,,0,0,0,,Nhưng mà hai người trông chả giống nhau gì cả.
Dialogue: 0,0:50:24.78,0:50:28.15,Default,,0,0,0,,Chú đến đây cũng phải một năm rồi nhỉ?
Dialogue: 0,0:50:28.80,0:50:30.01,Default,,0,0,0,,Hồi trước chú sống ở đâu thế?
Dialogue: 0,0:50:31.83,0:50:34.17,Default,,0,0,0,,Nghe đồn chuyện cậu với cô em đó là chị em chỉ là xạo thôi,
Dialogue: 0,0:50:34.50,0:50:37.70,Default,,0,0,0,,thật ra hai người là tình nhân bỏ trốn đó.
Dialogue: 0,0:50:38.18,0:50:39.36,Default,,0,0,0,,Đã để quý khách đợi lâu!
Dialogue: 0,0:50:41.07,0:50:43.01,Default,,0,0,0,,Cảm ơn quý khách.
Dialogue: 0,0:50:45.16,0:50:46.41,Default,,0,0,0,,Chào mừng quý khách!
Dialogue: 0,0:50:49.95,0:50:51.79,Default,,0,0,0,,Lại có người tới nữa?
Dialogue: 0,0:50:52.39,0:50:54.97,Default,,0,0,0,,Cần bao nhiêu lính gác mới vừa lòng bọn chúng đây?
Dialogue: 0,0:50:55.49,0:50:57.65,Default,,0,0,0,,Dù sao thì sắt cũng đang là xu thế mà.
Dialogue: 0,0:50:58.19,0:51:00.64,Default,,0,0,0,,Nhờ triều đình Mezarte đang ra sức chế tạo súng thần công,
Dialogue: 0,0:51:00.70,0:51:02.53,Default,,0,0,0,,nên bọn mình mới có cái ăn đấy.
Dialogue: 0,0:51:21.92,0:51:24.26,Default,,0,0,0,,Mà tôi thấy có gì đó là lạ.
Dialogue: 0,0:51:24.91,0:51:26.80,Default,,0,0,0,,Không lẽ họ định khơi mào chiến tranh?
Dialogue: 0,0:51:27.43,0:51:30.45,Default,,0,0,0,,Cái tên hoàng tử ngáo ngơ đó thì làm sao mà lãnh binh được.
Dialogue: 0,0:51:30.45,0:51:31.09,Default,,0,0,0,,Chuẩn rồi.
Dialogue: 0,0:51:37.75,0:51:39.27,Default,,0,0,0,,Chuyện thường ngày ở đây đấy ạ.
Dialogue: 0,0:51:39.76,0:51:41.16,Default,,0,0,0,,Xin quý khách thứ lỗi vì tiếng ồn nhé.
Dialogue: 0,0:51:41.48,0:51:43.60,Default,,0,0,0,,Thực đơn ở đây ạ.
Dialogue: 0,0:51:54.14,0:51:55.19,Default,,0,0,0,,Maquia!
Dialogue: 0,0:51:55.73,0:51:56.73,Default,,0,0,0,,Lang?
Dialogue: 0,0:51:58.56,0:52:00.01,Default,,0,0,0,,Đúng là Maquia rồi!
Dialogue: 0,0:52:00.01,0:52:01.36,Default,,0,0,0,,Trông cậu vẫn vậy ha!
Dialogue: 0,0:52:01.51,0:52:02.47,Default,,0,0,0,,À mà dĩ nhiên là vậy rồi.
Dialogue: 0,0:52:02.94,0:52:04.40,Default,,0,0,0,,Lang thay đổi quá trời luôn nè!
Dialogue: 0,0:52:04.90,0:52:06.87,Default,,0,0,0,,Sao cậu lớn quá vậy?
Dialogue: 0,0:52:07.22,0:52:09.34,Default,,0,0,0,,Đừng có xem người ta như cây lúa chứ.
Dialogue: 0,0:52:11.66,0:52:13.41,Default,,0,0,0,,Này, Ariel!
Dialogue: 0,0:52:13.83,0:52:15.08,Default,,0,0,0,,Ariel!
Dialogue: 0,0:52:15.88,0:52:18.18,Default,,0,0,0,,Là Lang nè! Anh Lang đó!
Dialogue: 0,0:52:18.69,0:52:20.24,Default,,0,0,0,,Nhóc, Ariel đó à?!
Dialogue: 0,0:52:31.87,0:52:33.26,Default,,0,0,0,,Tôi làm phiền vậy có ổn không?
Dialogue: 0,0:52:33.53,0:52:35.84,Default,,0,0,0,,Không sao. Xin lỗi vì hơi bừa bộn nhé.
Dialogue: 0,0:52:36.68,0:52:37.89,Default,,0,0,0,,Nhưng mà tớ vui lắm.
Dialogue: 0,0:52:38.28,0:52:39.99,Default,,0,0,0,,Mido với Deol vẫn khoẻ chứ?
Dialogue: 0,0:52:41.43,0:52:44.35,Default,,0,0,0,,Nhưng chỉ có mấy thành thị như Doriel mới trông khá khẩm thôi.
Dialogue: 0,0:52:44.93,0:52:46.88,Default,,0,0,0,,Còn ở quê thì mọi thứ đều đang già đi.
Dialogue: 0,0:52:47.83,0:52:49.09,Default,,0,0,0,,Deol cũng đi rồi.
Dialogue: 0,0:52:49.20,0:52:50.14,Default,,0,0,0,,À, cảm ơn nhé.
Dialogue: 0,0:52:50.63,0:52:52.26,Default,,0,0,0,,Deol cũng tìm việc à?
Dialogue: 0,0:52:52.73,0:52:54.48,Default,,0,0,0,,Không đi làm thì sao nó sống.
Dialogue: 0,0:52:55.25,0:52:57.30,Default,,0,0,0,,Ra ngoài chút.
Dialogue: 0,0:52:59.22,0:53:01.39,Default,,0,0,0,,Gì đó, đi chơi với gái hả nhóc?
Dialogue: 0,0:53:01.60,0:53:03.78,Default,,0,0,0,,Không, em phải làm ca đêm.
Dialogue: 0,0:53:05.19,0:53:06.80,Default,,0,0,0,,Cẩn thận nhé, Ariel.
Dialogue: 0,0:53:07.49,0:53:09.23,Default,,0,0,0,,Để mẹ chuẩn bị bữa ăn nhẹ cho.
Dialogue: 0,0:53:18.78,0:53:21.30,Default,,0,0,0,,Kể từ khi bọn tớ tới đây làm việc,
Dialogue: 0,0:53:21.97,0:53:23.70,Default,,0,0,0,,thằng bé đã rất cố gắng.
Dialogue: 0,0:53:24.18,0:53:24.99,Default,,0,0,0,,Ra vậy.
Dialogue: 0,0:53:25.88,0:53:28.21,Default,,0,0,0,,Tớ đâu thể bán Hibiol phải không?
Dialogue: 0,0:53:28.62,0:53:33.01,Default,,0,0,0,,Và cũng tại tớ mà 2 mẹ con phải chịu cảnh nay đây mai đó.
Dialogue: 0,0:53:35.88,0:53:37.94,Default,,0,0,0,,Cậu nói phải...
Dialogue: 0,0:53:38.63,0:53:41.06,Default,,0,0,0,,Chắc thằng bé đã biết...
Dialogue: 0,0:53:41.35,0:53:42.73,Default,,0,0,0,,hai người không cùng huyết thống nhỉ.
Dialogue: 0,0:53:46.79,0:53:48.08,Default,,0,0,0,,Khoảng 5 năm về trước.
Dialogue: 0,0:53:48.82,0:53:51.45,Default,,0,0,0,,Từ khi thằng bé muốn ra ngủ riêng cơ.
Dialogue: 0,0:53:52.31,0:53:54.41,Default,,0,0,0,,Từ đó nó không gọi tớ là mẹ nữa.
Dialogue: 0,0:53:56.21,0:53:59.25,Default,,0,0,0,,"Nè!" hay là "Chờ chút!" này...
Dialogue: 0,0:53:59.63,0:54:00.85,Default,,0,0,0,,Giờ nó toàn nói kiểu đó,
Dialogue: 0,0:54:00.96,0:54:03.66,Default,,0,0,0,,Cũng phải thôi, thằng bé là con trai mà.
Dialogue: 0,0:54:04.79,0:54:05.74,Default,,0,0,0,,Nè, Lang.
Dialogue: 0,0:54:07.09,0:54:09.47,Default,,0,0,0,,Cậu có biết chuyện gì đã xảy ra với Leilia không?
Dialogue: 0,0:54:19.42,0:54:20.82,Default,,0,0,0,,Thêm một con nữa chết.
Dialogue: 0,0:54:23.72,0:54:27.17,Default,,0,0,0,,Hoả thiêu nó rồi chôn thật sâu dưới đất.
Dialogue: 0,0:54:30.20,0:54:31.34,Default,,0,0,0,,Con sợ lắm.
Dialogue: 0,0:54:31.59,0:54:33.71,Default,,0,0,0,,Không sao đâu, Medmel điện hạ.
Dialogue: 0,0:54:34.21,0:54:35.89,Default,,0,0,0,,Nè, cha ta đâu?
Dialogue: 0,0:54:36.04,0:54:38.29,Default,,0,0,0,,Hazel điện hạ rất là bận rộn.
Dialogue: 0,0:54:41.09,0:54:41.98,Default,,0,0,0,,Còn mẹ ta...
Dialogue: 0,0:54:43.53,0:54:44.67,Default,,0,0,0,,Medmel điện hạ?
Dialogue: 0,0:54:47.37,0:54:48.52,Default,,0,0,0,,Không có gì.
Dialogue: 0,0:54:50.33,0:54:54.46,Default,,0,0,0,,Màu tóc tựa ánh trăng, đôi mắt ánh lên hình chiếc vòng bằng vàng,
Dialogue: 0,0:54:54.46,0:54:57.96,Default,,0,0,0,,người Iorph còn được cho là trường sinh bất lão,
Dialogue: 0,0:54:58.09,0:55:01.75,Default,,0,0,0,,vậy mà công chúa Medmel chẳng có đặc điểm nào trong số đó cả.
Dialogue: 0,0:55:01.92,0:55:02.71,Default,,0,0,0,,Không thể nào!
Dialogue: 0,0:55:03.08,0:55:05.80,Default,,0,0,0,,Nếu không thể sinh được con nối dõi,
Dialogue: 0,0:55:05.80,0:55:08.41,Default,,0,0,0,,thì mấy con quái vật đó tồn tại để làm gì chứ?
Dialogue: 0,0:55:10.68,0:55:13.56,Default,,0,0,0,,Sau khi hạ sinh Medmel điện hạ thì việc mang thai đã trở nên khó khăn hơn.
Dialogue: 0,0:55:13.78,0:55:17.88,Default,,0,0,0,,Và dường như thái tử Hazel cũng đã chán Leilia rồi.
Dialogue: 0,0:55:18.81,0:55:21.19,Default,,0,0,0,,Hazel tội nghiệp của trẫm!
Dialogue: 0,0:55:21.44,0:55:22.64,Default,,0,0,0,,Làm gì đó đi chứ!
Dialogue: 0,0:55:22.76,0:55:25.39,Default,,0,0,0,,Chí ít cũng phải kiếm cho nó một con mụ khác chứ!
Dialogue: 0,0:55:26.61,0:55:29.13,Default,,0,0,0,,Chúng thần sẽ tìm một người Iorph còn sống...
Dialogue: 0,0:55:29.17,0:55:31.25,Default,,0,0,0,,rồi cho ả làm vật thế thân.
Dialogue: 0,0:55:32.43,0:55:33.17,Default,,0,0,0,,Không!
Dialogue: 0,0:55:33.44,0:55:34.45,Default,,0,0,0,,Leilia-sama!
Dialogue: 0,0:55:36.12,0:55:38.31,Default,,0,0,0,,Nếu ta phải đeo mấy thứ trang sức này,
Dialogue: 0,0:55:38.74,0:55:40.48,Default,,0,0,0,,nếu hắn ta không muốn lên giường với ta nữa,
Dialogue: 0,0:55:41.04,0:55:42.89,Default,,0,0,0,,thì cứ vứt ta đi!
Dialogue: 0,0:55:48.02,0:55:49.08,Default,,0,0,0,,Leilia-sama đang...
Dialogue: 0,0:55:49.30,0:55:50.45,Default,,0,0,0,,Chỗ này để ta lo.
Dialogue: 0,0:55:56.89,0:55:58.32,Default,,0,0,0,,Một con Renato nữa đã chết rồi phải không?
Dialogue: 0,0:55:59.29,0:55:59.88,Default,,0,0,0,,Vâng.
Dialogue: 0,0:56:01.39,0:56:03.07,Default,,0,0,0,,Từ khi tôi hạ sinh Medmel,
Dialogue: 0,0:56:04.59,0:56:06.78,Default,,0,0,0,,lúc nào tôi cũng bị giam cầm ở đây.
Dialogue: 0,0:56:08.15,0:56:09.68,Default,,0,0,0,,Kể cả nhìn mặt nó, tôi cũng không được phép.
Dialogue: 0,0:56:12.50,0:56:13.34,Default,,0,0,0,,Nhất định...
Dialogue: 0,0:56:14.54,0:56:16.41,Default,,0,0,0,,những con Renato đấy cũng giống vậy.
Dialogue: 0,0:56:17.47,0:56:21.22,Default,,0,0,0,,Những sinh mệnh mơ hồ chỉ có trong thần thoại.
Dialogue: 0,0:56:23.47,0:56:25.11,Default,,0,0,0,,Kể cả chủng tộc biết bay,
Dialogue: 0,0:56:26.08,0:56:27.61,Default,,0,0,0,,hay loài hoa có thể hát lúc bình minh,
Dialogue: 0,0:56:28.34,0:56:30.36,Default,,0,0,0,,cũng không thể sống nổi trong thế giới này.
Dialogue: 0,0:56:31.58,0:56:33.56,Default,,0,0,0,,Thần tin chắc nương nương có thể chịu đựng được.
Dialogue: 0,0:56:34.06,0:56:36.35,Default,,0,0,0,,Để có thể tìm kiếm con đường thoát khỏi cái gọi là thần thoại.
Dialogue: 0,0:56:39.10,0:56:40.28,Default,,0,0,0,,Nói hay lắm.
Dialogue: 0,0:56:42.09,0:56:46.19,Default,,0,0,0,,Không phải chính ngươi đã giết chết thần thoại đó sao!?
Dialogue: 0,0:57:04.60,0:57:07.17,Default,,0,0,0,,Xin phép cho thần được chuộc tội.
Dialogue: 0,0:57:07.17,0:57:08.10,Default,,0,0,0,,Đừng có đùa!
Dialogue: 0,0:57:09.50,0:57:11.57,Default,,0,0,0,,Thế thì đưa ta tới gặp Medmel đi!
Dialogue: 0,0:57:12.13,0:57:14.05,Default,,0,0,0,,Sao lại không cho ta gặp con bé hả?
Dialogue: 0,0:57:14.83,0:57:16.66,Default,,0,0,0,,Nó là con của ta kia mà!
Dialogue: 0,0:57:17.97,0:57:21.11,Default,,0,0,0,,Ta đã quên mất mùi hương của con bé rồi.
Dialogue: 0,0:57:23.21,0:57:25.45,Default,,0,0,0,,Cả sự mềm mại của nó khi được ôm vào lòng nữa
Dialogue: 0,0:57:26.91,0:57:28.00,Default,,0,0,0,,Tại sao...
Dialogue: 0,0:57:28.77,0:57:32.02,Default,,0,0,0,,Các ngươi còn muốn tước đoạt bao nhiêu thứ của ta nữa hả?!
Dialogue: 0,0:57:32.87,0:57:33.98,Default,,0,0,0,,Các ngươi còn muốn...
Dialogue: 0,0:57:34.50,0:57:37.25,Default,,0,0,0,,ta cô độc đến nhường nào hả...?!
Dialogue: 0,0:57:39.03,0:57:40.77,Default,,0,0,0,,Nếu đã không muốn ta gặp Medmel,
Dialogue: 0,0:57:41.71,0:57:43.32,Default,,0,0,0,,thì mau đưa ta tới chỗ Maquia!
Dialogue: 0,0:57:47.31,0:57:48.28,Default,,0,0,0,,Xin ngươi...
Dialogue: 0,0:57:49.04,0:57:50.61,Default,,0,0,0,,Người Iorph tên Maquia.
Dialogue: 0,0:57:51.60,0:57:52.26,Default,,0,0,0,,Ta không muốn cậu ấy...
Dialogue: 0,0:57:53.37,0:57:55.94,Default,,0,0,0,,chịu cảnh cô độc...
Dialogue: 0,0:58:07.54,0:58:09.36,Default,,0,0,0,,Kỹ tính quá ha.
Dialogue: 0,0:58:09.92,0:58:11.82,Default,,0,0,0,,Trước giờ chỉ có 2 mẹ con ta thôi mà.
Dialogue: 0,0:58:12.24,0:58:14.77,Default,,0,0,0,,Đó giờ cũng đâu có ai tới chơi.
Dialogue: 0,0:58:19.38,0:58:20.86,Default,,0,0,0,,Nè, lại giúp mẹ chút.
Dialogue: 0,0:58:31.09,0:58:32.66,Default,,0,0,0,,Con lại cao hơn rồi.
Dialogue: 0,0:58:33.12,0:58:34.24,Default,,0,0,0,,Gì chứ?
Dialogue: 0,0:58:40.54,0:58:42.29,Default,,0,0,0,,Maquia, chúng ta cần nói chuyện.
Dialogue: 0,0:58:43.01,0:58:44.71,Default,,0,0,0,,Khi nào xong việc thì gặp tớ một lát nhé.
Dialogue: 0,0:58:45.49,0:58:46.85,Default,,0,0,0,,Ừ, nhưng tớ còn...
Dialogue: 0,0:58:46.85,0:58:48.26,Default,,0,0,0,,Tớ sẽ làm vài ly chờ cậu.
Dialogue: 0,0:58:49.32,0:58:51.21,Default,,0,0,0,,Maquia, mau đưa thức ăn tới cho khách!
Dialogue: 0,0:58:51.21,0:58:51.88,Default,,0,0,0,,Vâng.
Dialogue: 0,0:58:57.64,0:59:00.80,Default,,0,0,0,,Vì nghĩ cô ấy là người phụ nữ của chú nên anh mới kiềm chế lại đấy.
Dialogue: 0,0:59:01.21,0:59:02.56,Default,,0,0,0,,Chuẩn đó.
Dialogue: 0,0:59:03.01,0:59:06.07,Default,,0,0,0,,Ngoài kia còn biết bao nhiêu gã trai tốt mà, nhể?
Dialogue: 0,0:59:07.29,0:59:09.31,Default,,0,0,0,,Sao lại rơi vào tay của gã kia chứ...
Dialogue: 0,0:59:09.49,0:59:11.20,Default,,0,0,0,,Người ấy không phải như vậy.
Dialogue: 0,0:59:12.08,0:59:13.05,Default,,0,0,0,,Người ấy?
Dialogue: 0,0:59:13.60,0:59:15.20,Default,,0,0,0,,Mặt mày ủ rũ thế cu.
Dialogue: 0,0:59:15.63,0:59:16.84,Default,,0,0,0,,Thôi làm vài ly đi!
Dialogue: 0,0:59:17.52,0:59:18.43,Default,,0,0,0,,Không, tôi...
Dialogue: 0,0:59:18.72,0:59:20.36,Default,,0,0,0,,Thôi nào, chú có còn là con nít nữa đâu.
Dialogue: 0,0:59:26.01,0:59:27.23,Default,,0,0,0,,Thú vị đó.
Dialogue: 0,0:59:27.33,0:59:29.09,Default,,0,0,0,,Vậy chắc loại này cũng nốc được nhỉ.
Dialogue: 0,0:59:30.75,0:59:33.13,Default,,0,0,0,,Giờ là lúc để chú thành người lớn đấy.
Dialogue: 0,0:59:33.29,0:59:35.33,Default,,0,0,0,,Uống đi, uống đi!
Dialogue: 0,0:59:35.38,0:59:37.26,Default,,0,0,0,,Nếu là đàn ông thì...
Dialogue: 0,0:59:37.33,0:59:39.13,Default,,0,0,0,,Máu lửa lên! Trăm phần đê!
Dialogue: 0,0:59:39.28,0:59:41.17,Default,,0,0,0,,Máu lửa lên! Trăm phần đê!
Dialogue: 0,0:59:41.30,0:59:43.20,Default,,0,0,0,,Uống dzô! Uống dzô!
Dialogue: 0,0:59:43.25,0:59:45.19,Default,,0,0,0,,Uống dzô! Uống dzô!
Dialogue: 0,0:59:47.02,0:59:48.31,Default,,0,0,0,,Không tồi đấy chứ!
Dialogue: 0,0:59:48.31,0:59:49.71,Default,,0,0,0,,Cốc nữa nào!
Dialogue: 0,0:59:50.18,0:59:52.26,Default,,0,0,0,,Cùng trở thành đàn ông nào!
Dialogue: 0,0:59:57.05,0:59:58.40,Default,,0,0,0,,Họ đang tìm tớ ư?
Dialogue: 0,1:00:01.15,1:00:03.28,Default,,0,0,0,,Vậy tớ không thể ở lại thành phố này được.
Dialogue: 0,1:00:04.43,1:00:06.79,Default,,0,0,0,,Vậy có muốn cùng tớ về trang trại không?
Dialogue: 0,1:00:07.09,1:00:08.68,Default,,0,0,0,,Nhưng mà...
Dialogue: 0,1:00:08.73,1:00:09.83,Default,,0,0,0,,Sẽ ổn cả thôi!
Dialogue: 0,1:00:10.24,1:00:11.98,Default,,0,0,0,,Giá sữa dê đã tăng lên.
Dialogue: 0,1:00:12.56,1:00:13.79,Default,,0,0,0,,Cậu thì được ở bên Ariel.
Dialogue: 0,1:00:14.48,1:00:15.99,Default,,0,0,0,,Tớ đâu thể gây phiền hà cho cậu được.
Dialogue: 0,1:00:16.34,1:00:17.15,Default,,0,0,0,,Maquia.
Dialogue: 0,1:00:17.68,1:00:21.24,Default,,0,0,0,,Nhỡ Mido với Deol bị kéo vào chuyện này thì...
Dialogue: 0,1:00:22.21,1:00:23.06,Default,,0,0,0,,Tớ...
Dialogue: 0,1:00:24.55,1:00:25.29,Default,,0,0,0,,Tớ muốn...
Dialogue: 0,1:00:26.70,1:00:28.05,Default,,0,0,0,,cậu gây phiền hà cho tớ.
Dialogue: 0,1:00:29.86,1:00:31.25,Default,,0,0,0,,Từ nhỏ...
Dialogue: 0,1:00:31.93,1:00:34.03,Default,,0,0,0,,tớ đã muốn mạnh mẽ như Maquia.
Dialogue: 0,1:00:35.82,1:00:37.34,Default,,0,0,0,,Tớ muốn cậu cân nhắc, Maquia.
Dialogue: 0,1:00:38.88,1:00:39.88,Default,,0,0,0,,Về tương lai.
Dialogue: 0,1:00:40.63,1:00:41.26,Default,,0,0,0,,Và còn...
Dialogue: 0,1:00:43.46,1:00:44.45,Default,,0,0,0,,về chuyện hai đứa mình nữa.
Dialogue: 0,1:01:01.95,1:01:03.12,Default,,0,0,0,,Không được đâu.
Dialogue: 0,1:01:03.52,1:01:04.43,Default,,0,0,0,,Tớ nghĩ rồi.
Dialogue: 0,1:01:06.45,1:01:09.82,Default,,0,0,0,,Ariel luôn là người duy nhất mà tớ nghĩ tới.
Dialogue: 0,1:01:11.91,1:01:14.74,Default,,0,0,0,,Làm sao tớ có thể sống chung với Ariel?
Dialogue: 0,1:01:16.13,1:01:19.00,Default,,0,0,0,,Làm sao để trở thành một người mẹ thực sự?
Dialogue: 0,1:01:20.42,1:01:24.12,Default,,0,0,0,,Nhưng dường như tớ không tìm được câu trả lời.
Dialogue: 0,1:01:25.83,1:01:29.94,Default,,0,0,0,,Bây giờ cũng vậy, tớ vẫn không tìm được.
Dialogue: 0,1:01:32.50,1:01:35.14,Default,,0,0,0,,Vì tớ không thông minh,
Dialogue: 0,1:01:36.42,1:01:39.58,Default,,0,0,0,,nên tớ chỉ muốn...
Dialogue: 0,1:01:40.66,1:01:42.11,Default,,0,0,0,,tiếp tục nghĩ về Ariel mà thôi.
Dialogue: 0,1:01:48.65,1:01:49.52,Default,,0,0,0,,Được rồi.
Dialogue: 0,1:01:50.55,1:01:51.23,Default,,0,0,0,,Nhưng mà...
Dialogue: 0,1:01:52.20,1:01:56.30,Default,,0,0,0,,để tớ giúp cậu tìm nơi ở với công việc khác cho.
Dialogue: 0,1:01:57.20,1:01:58.57,Default,,0,0,0,,Đừng gánh vác mọi chuyện một mình nữa.
Dialogue: 0,1:02:30.42,1:02:31.28,Default,,0,0,0,,Ariel?
Dialogue: 0,1:02:36.04,1:02:37.31,Default,,0,0,0,,Con đang làm gì thế?
Dialogue: 0,1:02:38.92,1:02:40.08,Default,,0,0,0,,Con say rồi!
Dialogue: 0,1:02:40.67,1:02:41.83,Default,,0,0,0,,Về rồi đây...
Dialogue: 0,1:02:42.01,1:02:43.46,Default,,0,0,0,,Về gì mà về chứ!
Dialogue: 0,1:02:43.72,1:02:44.79,Default,,0,0,0,,Con sao thế Ariel?!
Dialogue: 0,1:02:44.79,1:02:46.29,Default,,0,0,0,,Nụ hôn khi về nhà đâu?
Dialogue: 0,1:02:47.28,1:02:51.33,Default,,0,0,0,,Không phải hồi trước luôn là vậy sao?
Dialogue: 0,1:02:54.94,1:02:55.65,Default,,0,0,0,,Mẹ xin lỗi.
Dialogue: 0,1:02:56.59,1:02:58.48,Default,,0,0,0,,Con đứng dậy được không?
Dialogue: 0,1:02:59.12,1:03:04.08,Default,,0,0,0,,Mọi người đều nghĩ 2 ta là cặp tình nhân bỏ trốn đấy.
Dialogue: 0,1:03:05.73,1:03:08.41,Default,,0,0,0,,Còn bảo sẽ bị gã khác cướp đi...
Dialogue: 0,1:03:09.72,1:03:11.03,Default,,0,0,0,,Con nói gì vậy hả?
Dialogue: 0,1:03:11.24,1:03:12.98,Default,,0,0,0,,Thôi, đứng dậy đi!
Dialogue: 0,1:03:13.55,1:03:15.21,Default,,0,0,0,,Nếu muốn ngủ thì lên giường cái đã...
Dialogue: 0,1:03:25.26,1:03:26.22,Default,,0,0,0,,Con đi được không?
Dialogue: 0,1:03:33.75,1:03:34.65,Default,,0,0,0,,Không được giẫm lên nó!
Dialogue: 0,1:03:42.12,1:03:42.89,Default,,0,0,0,,Đây là...
Dialogue: 0,1:03:44.64,1:03:46.57,Default,,0,0,0,,đoạn vải con đã dệt mà?
Dialogue: 0,1:03:52.58,1:03:53.47,Default,,0,0,0,,Tôi ghét nó!
Dialogue: 0,1:03:56.27,1:03:58.31,Default,,0,0,0,,Sao cứ khư khư giữ nó vậy hả?!
Dialogue: 0,1:03:59.45,1:04:01.20,Default,,0,0,0,,Lúc nào cũng đối xử với tôi như con nít!
Dialogue: 0,1:04:29.54,1:04:31.01,Default,,0,0,0,,Sẽ không thay đổi đâu!
Dialogue: 0,1:04:35.65,1:04:37.07,Default,,0,0,0,,Nó sẽ mãi là báu vật của mẹ!
Dialogue: 0,1:04:41.44,1:04:42.31,Default,,0,0,0,,Ariel!
Dialogue: 0,1:04:47.80,1:04:49.11,Default,,0,0,0,,Ariel này.
Dialogue: 0,1:04:49.80,1:04:52.33,Default,,0,0,0,,Chúng ta phải chuyển nhà nữa rồi.
Dialogue: 0,1:04:54.22,1:04:55.77,Default,,0,0,0,,Phải chuyển đi đâu đây nhỉ?
Dialogue: 0,1:04:56.39,1:04:58.02,Default,,0,0,0,,Mẹ thì đâu cũng được.
Dialogue: 0,1:04:59.56,1:05:00.99,Default,,0,0,0,,Miễn được ở bên con là được.
Dialogue: 0,1:05:02.71,1:05:03.68,Default,,0,0,0,,Tôi...
Dialogue: 0,1:05:04.57,1:05:07.44,Default,,0,0,0,,không có coi cô là mẹ!
Dialogue: 0,1:05:32.65,1:05:35.01,Default,,0,0,0,,Anh nói giúp em vài câu...
Dialogue: 0,1:05:35.55,1:05:37.14,Default,,0,0,0,,để em được nhận vào làm lính gác ở hoàng cung được không ạ?
Dialogue: 0,1:05:41.20,1:05:42.26,Default,,0,0,0,,Xin anh.
Dialogue: 0,1:05:43.33,1:05:44.98,Default,,0,0,0,,Maquia sẽ buồn lắm đấy.
Dialogue: 0,1:05:45.82,1:05:47.23,Default,,0,0,0,,Cô ta đâu phải mẹ em.
Dialogue: 0,1:05:48.86,1:05:49.86,Default,,0,0,0,,Nhóc đã nói vậy à?
Dialogue: 0,1:05:52.15,1:05:53.77,Default,,0,0,0,,Nhóc đã nói những lời đó với Maquia à?
Dialogue: 0,1:05:54.80,1:05:55.68,Default,,0,0,0,,Đúng vậy.
Dialogue: 0,1:05:57.89,1:05:59.06,Default,,0,0,0,,Nhóc có biết...
Dialogue: 0,1:05:59.52,1:06:02.34,Default,,0,0,0,,khi nuôi lớn nhóc, Maquia đã phải trải qua những cung bậc cảm xúc gì không hả?!
Dialogue: 0,1:06:03.74,1:06:04.69,Default,,0,0,0,,Đừng có giả ngơ!
Dialogue: 0,1:06:05.49,1:06:07.14,Default,,0,0,0,,Khi cô ấy trạc tuổi nhóc bây giờ,
Dialogue: 0,1:06:07.30,1:06:09.65,Default,,0,0,0,,Maquia đã cố gắng hết sức để làm một người mẹ tốt.
Dialogue: 0,1:06:10.17,1:06:10.99,Default,,0,0,0,,Vậy mà...
Dialogue: 0,1:06:11.60,1:06:12.89,Default,,0,0,0,,Ai mà biết hả?!
Dialogue: 0,1:06:15.01,1:06:19.65,Default,,0,0,0,,Sao người ấy lại xem em như báu vật vậy hả?!
Dialogue: 0,1:06:23.58,1:06:24.50,Default,,0,0,0,,Ariel.
Dialogue: 0,1:06:25.25,1:06:26.93,Default,,0,0,0,,Luôn ở bên cạnh em...
Dialogue: 0,1:06:27.86,1:06:30.17,Default,,0,0,0,,làm mọi thứ vì em...
Dialogue: 0,1:06:31.25,1:06:34.52,Default,,0,0,0,,những chuyện mà em nghĩ chỉ có mẹ mới làm...
Dialogue: 0,1:06:35.46,1:06:38.12,Default,,0,0,0,,Thế nên em mới gọi người ấy là mẹ.
Dialogue: 0,1:06:41.46,1:06:42.77,Default,,0,0,0,,Em muốn bảo vệ cô ấy!
Dialogue: 0,1:06:46.95,1:06:49.68,Default,,0,0,0,,Nhưng với con người hiện tại của em thì làm sao được.
Dialogue: 0,1:06:50.76,1:06:52.00,Default,,0,0,0,,Hơn nữa,
Dialogue: 0,1:06:53.87,1:06:54.91,Default,,0,0,0,,em đã làm tổn thương cô ấy!
Dialogue: 0,1:06:56.23,1:06:58.55,Default,,0,0,0,,Em đã nhận ra cảm xúc đó.
Dialogue: 0,1:07:00.81,1:07:03.26,Default,,0,0,0,,Rằng mình không thể bảo vệ cô ấy được!
Dialogue: 0,1:07:16.39,1:07:18.30,Default,,0,0,0,,Nhìn nhóc khóc...
Dialogue: 0,1:07:19.14,1:07:20.85,Default,,0,0,0,,không khác gì lúc còn bé cả.
Dialogue: 0,1:07:25.60,1:07:27.85,Default,,0,0,0,,Có thật là nhóc muốn làm không?
Dialogue: 0,1:07:47.77,1:07:49.85,Default,,0,0,0,,Không sao, tôi tự làm được.
Dialogue: 0,1:07:50.27,1:07:51.80,Default,,0,0,0,,Cô còn phải xuống phố mà phải không?
Dialogue: 0,1:07:52.73,1:07:54.89,Default,,0,0,0,,Để mẹ tiễn con nhé, Ariel.
Dialogue: 0,1:08:07.09,1:08:09.20,Default,,0,0,0,,Bảo trọng nhé, Ariel.
Dialogue: 0,1:08:11.95,1:08:12.98,Default,,0,0,0,,Lên đường bình an.
Dialogue: 0,1:08:18.65,1:08:19.54,Default,,0,0,0,,Tôi đi đây.
Dialogue: 0,1:08:55.21,1:08:57.12,Default,,0,0,0,,Mình không khóc...
Dialogue: 0,1:08:58.40,1:08:59.38,Default,,0,0,0,,không khóc đâu.
Dialogue: 0,1:09:00.32,1:09:01.37,Default,,0,0,0,,Mình hứa rồi mà!
Dialogue: 0,1:09:05.78,1:09:07.73,Default,,0,0,0,,Ariel là đồ nói dối.
Dialogue: 0,1:09:08.78,1:09:10.80,Default,,0,0,0,,Con hứa là sẽ bảo vệ mẹ mà...
Dialogue: 0,1:09:14.31,1:09:15.33,Default,,0,0,0,,Đồ nói dối.
Dialogue: 0,1:09:17.76,1:09:18.80,Default,,0,0,0,,Đáng ghét.
Dialogue: 0,1:10:32.42,1:10:36.60,Default,,0,0,0,,Cứ tưởng là sẽ gặp được một con Renato xịn chứ.
Dialogue: 0,1:10:36.88,1:10:38.32,Default,,0,0,0,,Biết làm sao được con.
Dialogue: 0,1:10:38.45,1:10:43.31,Default,,0,0,0,,Lúc trước thì còn nhiều, nhưng giờ chỉ còn một con trong lâu đài thôi.
Dialogue: 0,1:10:44.51,1:10:47.36,Default,,0,0,0,,Diễu hành với cái con Renato dỏm này...
Dialogue: 0,1:10:47.44,1:10:49.92,Default,,0,0,0,,thì sao có thể nâng sĩ khí lên được chứ.
Dialogue: 0,1:10:50.56,1:10:52.01,Default,,0,0,0,,À mà cậu biết gì chưa?
Dialogue: 0,1:10:52.40,1:10:54.99,Default,,0,0,0,,Baiera mới tia được một em Iorph khác đấy.
Dialogue: 0,1:10:55.04,1:10:56.82,Default,,0,0,0,,Baiera á? Thật không?
Dialogue: 0,1:11:00.39,1:11:04.11,Default,,0,0,0,,Sư đoàn trưởng à, đừng có thiêu mấy con bọ nữa.
Dialogue: 0,1:11:04.62,1:11:05.37,Default,,0,0,0,,Im đi!
Dialogue: 0,1:11:05.96,1:11:06.99,Default,,0,0,0,,Sư đoàn trưởng Lang!
Dialogue: 0,1:11:10.87,1:11:12.73,Default,,0,0,0,,Ừ, vẫn đang tìm.
Dialogue: 0,1:11:13.59,1:11:16.66,Default,,0,0,0,,Hình như cô ấy trạc tuổi công chúa Leilia.
Dialogue: 0,1:11:19.23,1:11:21.02,Default,,0,0,0,,Nhưng chưa chắc đó là Maquia đâu.
Dialogue: 0,1:11:22.16,1:11:23.00,Default,,0,0,0,,Nhóc lo à?
Dialogue: 0,1:11:24.15,1:11:25.00,Default,,0,0,0,,Người ấy...
Dialogue: 0,1:11:25.63,1:11:26.78,Default,,0,0,0,,mạnh mẽ lắm.
Dialogue: 0,1:11:29.03,1:11:31.39,Default,,0,0,0,,Nếu nghe được mấy lời đó thì Maquia sẽ vui lắm đấy.
Dialogue: 0,1:11:32.35,1:11:35.14,Default,,0,0,0,,Vì lúc nào cũng lo không biết nhóc có biết tự bảo vệ mình không...
Dialogue: 0,1:11:35.65,1:11:38.69,Default,,0,0,0,,nên cô ấy mới bất an trong lòng.
Dialogue: 0,1:11:39.83,1:11:44.18,Default,,0,0,0,,Và để khiến nhóc xem cô ấy như người mẹ có thể dựa dẫm vào.
Dialogue: 0,1:11:46.45,1:11:47.80,Default,,0,0,0,,Nhóc chỉ là thằng ranh con thôi.
Dialogue: 0,1:11:51.65,1:11:54.18,Default,,0,0,0,,Có thể, em chỉ là một thằng ranh con...
Dialogue: 0,1:11:55.33,1:11:55.99,Default,,0,0,0,,Nhưng...
Dialogue: 0,1:11:56.60,1:11:59.02,Default,,0,0,0,,em sắp được làm cha rồi.
Dialogue: 0,1:12:07.57,1:12:08.71,Default,,0,0,0,,Mezarte.
Dialogue: 0,1:12:09.17,1:12:10.58,Default,,0,0,0,,Một quốc gia với đầu óc nông cạn.
Dialogue: 0,1:12:11.11,1:12:13.80,Default,,0,0,0,,Dám đổi chác sức mạnh cổ xưa với quyền lực chính trị.
Dialogue: 0,1:12:14.01,1:12:16.72,Default,,0,0,0,,Cứ tiếp tục báng bổ thánh thần như thế này thì thật quá ngu ngốc!
Dialogue: 0,1:12:17.46,1:12:21.17,Default,,0,0,0,,Hẳn các ngươi đang cần sự giúp sức từ bọn ta.
Dialogue: 0,1:12:41.12,1:12:41.86,Default,,0,0,0,,Maquia.
Dialogue: 0,1:12:43.02,1:12:44.42,Default,,0,0,0,,Việc chuẩn bị đã xong xuôi hết rồi.
Dialogue: 0,1:12:46.58,1:12:47.77,Default,,0,0,0,,Tóc cậu lại dài thêm rồi nhỉ.
Dialogue: 0,1:12:48.70,1:12:51.05,Default,,0,0,0,,Một tộc nhân Iorph để tóc dài quá hông...
Dialogue: 0,1:12:51.41,1:12:52.61,Default,,0,0,0,,đồng nghĩa với việc đã có khả năng mang thai.
Dialogue: 0,1:12:54.30,1:12:55.19,Default,,0,0,0,,Nào, Maquia.
Dialogue: 0,1:12:55.86,1:12:57.30,Default,,0,0,0,,Cùng đi gặp Leilia thôi.
Dialogue: 0,1:13:06.50,1:13:07.89,Default,,0,0,0,,Chiến tranh sẽ bùng nổ sao...
Dialogue: 0,1:13:08.70,1:13:10.58,Default,,0,0,0,,Nó chỉ đem lại đau khổ ở giai đoạn đầu thôi.
Dialogue: 0,1:13:11.41,1:13:12.94,Default,,0,0,0,,Hơn nữa, mấy năm gần đây,
Dialogue: 0,1:13:13.26,1:13:15.35,Default,,0,0,0,,nỗi đau mà cậu phải chịu đựng còn hơn cả thế.
Dialogue: 0,1:13:16.52,1:13:20.32,Default,,0,0,0,,Cậu bỏ lại tộc Iorph, rồi mọi thứ mà cậu có đều bị cướp đi.
Dialogue: 0,1:13:20.85,1:13:23.54,Default,,0,0,0,,Lủi thủi một mình trong hầm rượu như người đã chết...
Dialogue: 0,1:13:26.75,1:13:29.20,Default,,0,0,0,,Chắc hẳn cậu đã hiểu cảm giác của bọn tớ rồi nhỉ.
Dialogue: 0,1:13:30.03,1:13:31.60,Default,,0,0,0,,Giờ mỗi người một nơi,
Dialogue: 0,1:13:31.87,1:13:34.93,Default,,0,0,0,,trưởng lão thì chắc cũng chết luôn rồi.
Dialogue: 0,1:13:36.26,1:13:38.97,Default,,0,0,0,,Bọn tớ đau khổ vì đã mất tất cả.
Dialogue: 0,1:13:39.81,1:13:40.82,Default,,0,0,0,,Vậy mà trong lúc đó,
Dialogue: 0,1:13:41.57,1:13:44.06,Default,,0,0,0,,chỉ có cậu là người được hưởng hạnh phúc.
Dialogue: 0,1:13:45.23,1:13:48.56,Default,,0,0,0,,Tộc nhân Iorph phải đệt cùng một loại vải.
Dialogue: 0,1:13:49.24,1:13:51.36,Default,,0,0,0,,Tớ, Leilia và cả Maquia.
Dialogue: 0,1:13:51.71,1:13:54.72,Default,,0,0,0,,Không được phép xảy ra chuyện 3 đứa mình có quá khứ khác nhau.
Dialogue: 0,1:14:05.13,1:14:06.65,Default,,0,0,0,,Chúc mừng, Maquia.
Dialogue: 0,1:14:07.30,1:14:09.95,Default,,0,0,0,,Giờ thì chỉ có quá khứ của cậu biến mất.
Dialogue: 0,1:14:10.62,1:14:14.10,Default,,0,0,0,,3 đứa mình sẽ cùng nhau dệt nên một tương lai mới.
Dialogue: 0,1:14:36.01,1:14:36.81,Default,,0,0,0,,Dita!
Dialogue: 0,1:14:38.44,1:14:40.05,Default,,0,0,0,,Mừng anh về, Ariel!
Dialogue: 0,1:14:45.53,1:14:47.57,Default,,0,0,0,,Hôm nay anh về sớm thế?
Dialogue: 0,1:14:47.90,1:14:49.32,Default,,0,0,0,,Đang trong giai đoạn quan trọng mà.
Dialogue: 0,1:14:49.43,1:14:54.51,Default,,0,0,0,,- Xin lỗi vì dạo này anh bận quá.\N- Vẫn còn thời gian mà anh.
Dialogue: 0,1:14:55.97,1:14:57.35,Default,,0,0,0,,Nhưng anh lo lắm.
Dialogue: 0,1:14:58.21,1:14:59.53,Default,,0,0,0,,Đợi tí em dọn bữa tối lên nhé.
Dialogue: 0,1:15:00.13,1:15:02.80,Default,,0,0,0,,Ừ, nhưng đừng cố quá, để anh làm cho.
Dialogue: 0,1:15:03.57,1:15:05.85,Default,,0,0,0,,Đi lại chút có sao đâu nào.
Dialogue: 0,1:15:07.79,1:15:09.77,Default,,0,0,0,,Anh cứ ngồi nghỉ đi.
Dialogue: 0,1:15:14.89,1:15:17.33,Default,,0,0,0,,Cũng sắp đến lúc rồi nhỉ, trong người em bắt đầu thấy lạ rồi.
Dialogue: 0,1:15:19.41,1:15:22.30,Default,,0,0,0,,Em tìm được việc làm, sau đó rời khỏi Mezarte,
Dialogue: 0,1:15:23.01,1:15:25.03,Default,,0,0,0,,rồi gặp được Ariel,
Dialogue: 0,1:15:26.56,1:15:27.41,Default,,0,0,0,,đến bây giờ thì...
Dialogue: 0,1:15:30.29,1:15:31.27,Default,,0,0,0,,Này, Ariel.
Dialogue: 0,1:15:32.48,1:15:34.23,Default,,0,0,0,,có thật là anh chấp nhận em không?
Dialogue: 0,1:15:38.97,1:15:39.55,Default,,0,0,0,,Gì cơ?
Dialogue: 0,1:16:06.44,1:16:07.23,Default,,0,0,0,,Bọn Baiera đó à?
Dialogue: 0,1:16:07.82,1:16:09.28,Default,,0,0,0,,Không chỉ có thuyền của bọn Baiera.
Dialogue: 0,1:16:10.06,1:16:11.92,Default,,0,0,0,,Mà còn có cả York với Endra nữa!
Dialogue: 0,1:16:18.56,1:16:19.89,Default,,0,0,0,,Ariel, khoan đã!
Dialogue: 0,1:16:21.33,1:16:23.48,Default,,0,0,0,,Bảo vệ đứa con trong bụng dùm anh nhé!
Dialogue: 0,1:16:41.88,1:16:42.88,Default,,0,0,0,,Ariel, lề mề quá đấy.
Dialogue: 0,1:16:43.30,1:16:44.13,Default,,0,0,0,,Em xin lỗi!
Dialogue: 0,1:16:51.24,1:16:54.70,Default,,0,0,0,,Bọn ta vừa nhận được tin quân Baiera đã qua khỏi biên giới!
Dialogue: 0,1:16:55.10,1:16:55.90,Default,,0,0,0,,Mau chia thành 2 cánh quâ...!
Dialogue: 0,1:17:01.51,1:17:02.51,Default,,0,0,0,,Mỉa mai thật.
Dialogue: 0,1:17:10.65,1:17:15.81,Italics,,0,0,0,,Mezarte đã sử dụng sức mạnh cổ xưa để phô diễn sức mạnh quân sự của mình.
Dialogue: 0,1:17:16.67,1:17:17.79,Italics,,0,0,0,,Ngược lại.
Dialogue: 0,1:17:18.28,1:17:21.61,Italics,,0,0,0,,Vì dám lợi dụng sức mạnh cổ xưa, nên Mezarte sẽ bị trừng trị thích đáng.
Dialogue: 0,1:17:21.94,1:17:25.03,Italics,,0,0,0,,Kết quả là, các nước láng giềng đã hợp sức chống lại Mezarte, và chiến tranh bùng nổ.
Dialogue: 0,1:17:35.41,1:17:36.91,Default,,0,0,0,,Các quan đại thần đâu cả rồi?
Dialogue: 0,1:17:37.53,1:17:40.85,Default,,0,0,0,,Họ đã cùng người của mình trốn khỏi hoàng cung rồi ạ.
Dialogue: 0,1:17:41.82,1:17:43.61,Default,,0,0,0,,Chúng dám bỏ trẫm lại sao?!
Dialogue: 0,1:17:44.07,1:17:45.94,Default,,0,0,0,,Thế là thế nào chứ?!
Dialogue: 0,1:17:46.90,1:17:49.88,Default,,0,0,0,,Thôi xong rồi, vĩnh biệt các ngươi...
Dialogue: 0,1:17:51.00,1:17:52.62,Default,,0,0,0,,Bệ hạ, xin hãy nhanh lên.
Dialogue: 0,1:17:53.13,1:17:55.28,Default,,0,0,0,,Này, Medmel điện hạ thế nào rồi?
Dialogue: 0,1:17:56.24,1:17:57.62,Default,,0,0,0,,Con nhỏ có cái tên đáng ghét ấy ư?
Dialogue: 0,1:17:57.74,1:18:00.96,Default,,0,0,0,,Chúng ta không cần nó! \NCứ để mặc nó ở lại với mẹ mình đi!
Dialogue: 0,1:18:51.69,1:18:52.96,Default,,0,0,0,,Maquia, đi mau!
Dialogue: 0,1:19:28.89,1:19:29.64,Default,,0,0,0,,Ariel!
Dialogue: 0,1:19:32.63,1:19:33.23,Default,,0,0,0,,Ariel!
Dialogue: 0,1:19:51.44,1:19:52.21,Default,,0,0,0,,Leilia.
Dialogue: 0,1:19:54.01,1:19:55.10,Default,,0,0,0,,Cuối cùng cũng tìm được cậu.
Dialogue: 0,1:19:57.85,1:19:58.77,Default,,0,0,0,,Krim...?
Dialogue: 0,1:20:00.50,1:20:01.38,Default,,0,0,0,,Tại sao...?
Dialogue: 0,1:20:02.98,1:20:04.00,Default,,0,0,0,,Cậu vẫn còn sống ư?
Dialogue: 0,1:20:05.26,1:20:07.61,Default,,0,0,0,,Người tớ đang nhìn...
Dialogue: 0,1:20:11.33,1:20:12.35,Default,,0,0,0,,là ma ư?
Dialogue: 0,1:20:17.89,1:20:18.97,Default,,0,0,0,,Tớ tới đón cậu đây.
Dialogue: 0,1:20:20.80,1:20:21.57,Default,,0,0,0,,Từ giờ...
Dialogue: 0,1:20:22.51,1:20:24.37,Default,,0,0,0,,Những kẻ dám làm cậu đau khổ...
Dialogue: 0,1:20:25.14,1:20:27.17,Default,,0,0,0,,tớ sẽ trả hết những đau khổ ấy lại cho chúng.
Dialogue: 0,1:20:28.08,1:20:30.93,Default,,0,0,0,,Rồi bọn mình sẽ làm lại từ đầu.
Dialogue: 0,1:20:31.00,1:20:31.70,Default,,0,0,0,,Khoan đã.
Dialogue: 0,1:20:35.24,1:20:36.17,Default,,0,0,0,,Tớ muốn gặp con bé.
Dialogue: 0,1:20:37.09,1:20:39.01,Default,,0,0,0,,Con gái của tớ.
Dialogue: 0,1:20:40.53,1:20:41.78,Default,,0,0,0,,Cậu nói gì vậy hả?
Dialogue: 0,1:20:42.73,1:20:45.99,Default,,0,0,0,,Không phải nó chỉ là sinh mệnh ra đời ngoài ý muốn thôi sao?
Dialogue: 0,1:20:46.32,1:20:48.63,Default,,0,0,0,,Nhưng tớ đã sinh ra con bé...
Dialogue: 0,1:20:48.63,1:20:49.84,Default,,0,0,0,,Cứ quên đi là được mà!
Dialogue: 0,1:20:50.39,1:20:53.58,Default,,0,0,0,,Hibiol của cậu không có tên của con gái cậu!
Dialogue: 0,1:20:53.84,1:20:54.99,Default,,0,0,0,,N-Nhưng mà...
Dialogue: 0,1:20:56.58,1:20:58.84,Default,,0,0,0,,Krim, mọi người đều đã...
Dialogue: 0,1:20:58.84,1:20:59.91,Default,,0,0,0,,chết rồi kia mà...
Dialogue: 0,1:21:09.80,1:21:13.06,Default,,0,0,0,,Tớ cứ tưởng mình đã mất tất cả.
Dialogue: 0,1:21:13.88,1:21:18.28,Default,,0,0,0,,Thế nên lúc nào tớ cũng nghĩ đến con gái mình.
Dialogue: 0,1:21:19.75,1:21:22.24,Default,,0,0,0,,Tớ muốn gặp con bé.
Dialogue: 0,1:21:23.94,1:21:25.95,Default,,0,0,0,,Muốn ôm con bé.
Dialogue: 0,1:21:27.18,1:21:31.32,Default,,0,0,0,,Những cảm xúc ấy đã cho tớ động lực sống.
Dialogue: 0,1:21:33.88,1:21:34.71,Default,,0,0,0,,Leilia.
Dialogue: 0,1:21:37.77,1:21:40.20,Default,,0,0,0,,Medmel của tớ...
Dialogue: 0,1:21:54.58,1:21:56.54,Default,,0,0,0,,Tớ hiểu mà, Leilia.
Dialogue: 0,1:21:58.83,1:21:59.74,Default,,0,0,0,,Cùng nhau...
Dialogue: 0,1:22:00.86,1:22:01.89,Default,,0,0,0,,chấm dứt mọi chuyện ở đây nào.
Dialogue: 0,1:22:05.80,1:22:06.60,Default,,0,0,0,,Krim!
Dialogue: 0,1:22:12.40,1:22:13.21,Default,,0,0,0,,Tớ sẽ không...
Dialogue: 0,1:22:18.80,1:22:20.04,Default,,0,0,0,,để bất kỳ ai...
Dialogue: 0,1:22:23.06,1:22:24.72,Default,,0,0,0,,vấy bẩn Hibiol...
Dialogue: 0,1:22:25.94,1:22:27.06,Default,,0,0,0,,của bọn mình nữa đâu.
Dialogue: 0,1:22:35.29,1:22:36.10,Default,,0,0,0,,Krim!
Dialogue: 0,1:22:40.03,1:22:41.07,Default,,0,0,0,,Leilia-sama!
Dialogue: 0,1:23:13.41,1:23:14.85,Default,,0,0,0,,Tại sao vậy chứ?!
Dialogue: 0,1:23:16.01,1:23:17.06,Default,,0,0,0,,Leilia...
Dialogue: 0,1:23:17.72,1:23:18.67,Default,,0,0,0,,rồi đến Maquia...
Dialogue: 0,1:23:19.40,1:23:20.36,Default,,0,0,0,,Tại sao...?
Dialogue: 0,1:23:21.86,1:23:25.27,Default,,0,0,0,,Tại sao thời gian lại trôi chứ...?
Dialogue: 0,1:24:04.00,1:24:05.88,Default,,0,0,0,,Giống như ngày hôm ấy...
Dialogue: 0,1:24:33.19,1:24:33.83,Default,,0,0,0,,Ariel!
Dialogue: 0,1:24:35.97,1:24:36.90,Default,,0,0,0,,Sư đoàn trưởng!
Dialogue: 0,1:24:37.89,1:24:42.20,Default,,0,0,0,,Anh vừa nhận được tin một thiếu niên tộc Iorph đang ở trên thuyền của bọn Baeira cùng một cô gái.
Dialogue: 0,1:24:44.74,1:24:46.26,Default,,0,0,0,,Nhóc gặp họ rồi à?
Dialogue: 0,1:24:49.01,1:24:49.61,Default,,0,0,0,,Vâng.
Dialogue: 0,1:24:51.01,1:24:54.10,Default,,0,0,0,,Việc của nhóc xong rồi, còn lại để bọn anh lo.\NMau tới chỗ Maquia...!
Dialogue: 0,1:24:54.10,1:24:55.14,Default,,0,0,0,,Em sẽ chiến đấu!
Dialogue: 0,1:24:56.48,1:24:58.80,Default,,0,0,0,,Nhóc trung thành với Mezarte đến vậy sao?
Dialogue: 0,1:24:59.23,1:25:00.03,Default,,0,0,0,,Không phải à?
Dialogue: 0,1:25:00.37,1:25:02.34,Default,,0,0,0,,Lúc nào nhóc cũng né tránh ánh mắt của Maquia.
Dialogue: 0,1:25:02.34,1:25:02.97,Default,,0,0,0,,Không phải!
Dialogue: 0,1:25:04.70,1:25:07.04,Default,,0,0,0,,Ban đầu đúng là như vậy.
Dialogue: 0,1:25:08.16,1:25:10.62,Default,,0,0,0,,Nhưng giờ em có Dita.
Dialogue: 0,1:25:11.35,1:25:12.30,Default,,0,0,0,,Có bạn bè!
Dialogue: 0,1:25:13.07,1:25:14.67,Default,,0,0,0,,Và có đứa con sắp chào đời!
Dialogue: 0,1:25:15.90,1:25:21.21,Default,,0,0,0,,Từ khi rời xa người ấy, Mezarte này chính là nơi mà em thuộc về!
Dialogue: 0,1:25:21.64,1:25:22.95,Default,,0,0,0,,Em muốn bảo vệ nó!
Dialogue: 0,1:25:43.71,1:25:44.78,Default,,0,0,0,,Con không sao chứ?!
Dialogue: 0,1:25:51.29,1:25:52.00,Default,,0,0,0,,Cô là...
Dialogue: 0,1:25:52.05,1:25:52.79,Default,,0,0,0,,Đại phu!
Dialogue: 0,1:25:53.22,1:25:53.97,Default,,0,0,0,,Đừng!
Dialogue: 0,1:25:56.00,1:25:57.40,Default,,0,0,0,,Giờ không phải lúc...
Dialogue: 0,1:25:57.38,1:25:57.98,Default,,0,0,0,,Nhưng...!
Dialogue: 0,1:26:00.46,1:26:03.61,Default,,0,0,0,,Con của Ariel...!
Dialogue: 0,1:26:10.41,1:26:11.34,Default,,0,0,0,,Bắn!
Dialogue: 0,1:26:31.73,1:26:32.94,Default,,0,0,0,,Bắn!
Dialogue: 0,1:26:37.03,1:26:37.70,Default,,0,0,0,,Dita.
Dialogue: 0,1:26:39.68,1:26:41.81,Default,,0,0,0,,Gắng lên, sắp ra rồi!
Dialogue: 0,1:26:42.59,1:26:43.98,Default,,0,0,0,,Con sắp được gặp con mình rồi!
Dialogue: 0,1:27:04.92,1:27:06.27,Default,,0,0,0,,Phải phải, đúng rồi!
Dialogue: 0,1:27:07.66,1:27:09.69,Default,,0,0,0,,Dita, một chút nữa thôi!
Dialogue: 0,1:27:11.62,1:27:12.86,Default,,0,0,0,,Một chút nữa thôi!
Dialogue: 0,1:27:14.58,1:27:15.22,Default,,0,0,0,,Dita!
Dialogue: 0,1:27:22.37,1:27:23.46,Default,,0,0,0,,Không được nản chí!
Dialogue: 0,1:27:33.25,1:27:33.88,Default,,0,0,0,,Con sợ...
Dialogue: 0,1:27:35.91,1:27:36.44,Default,,0,0,0,,Dita!
Dialogue: 0,1:27:36.44,1:27:38.21,Default,,0,0,0,,Con sợ, sợ lắm...
Dialogue: 0,1:27:38.40,1:27:40.11,Default,,0,0,0,,Cứu với!
Dialogue: 0,1:27:40.11,1:27:41.58,Default,,0,0,0,,Dita, không sao đâu mà...
Dialogue: 0,1:27:40.98,1:27:42.37,Default,,0,0,0,,Đứa bé...
Dialogue: 0,1:27:42.76,1:27:45.69,Default,,0,0,0,,Đứa bé, hãy cứu đứa bé!
Dialogue: 0,1:27:45.69,1:27:46.60,Default,,0,0,0,,Mẹ sẽ cứu nó!
Dialogue: 0,1:27:47.96,1:27:48.77,Default,,0,0,0,,Nhất định sẽ cứu nó!
Dialogue: 0,1:27:51.90,1:27:54.26,Default,,0,0,0,,Trời sắp sáng rồi!\NĐánh vào thành mau!
Dialogue: 0,1:28:09.88,1:28:12.86,Default,,0,0,0,,Coi nào, đứa bé sắp chào đời rồi!
Dialogue: 0,1:28:16.15,1:28:20.18,Default,,0,0,0,,Con và Ariel sắp trở thành bậc cha mẹ rồi đấy!
Dialogue: 0,1:28:51.83,1:28:53.84,Default,,0,0,0,,Con vất vả rồi, Dita.
Dialogue: 0,1:28:55.20,1:28:56.08,Default,,0,0,0,,Mẹ.
Dialogue: 0,1:29:14.25,1:29:16.09,Flashback,,0,0,0,,Tính đem nó theo à?
Dialogue: 0,1:29:16.84,1:29:17.86,Flashback,,0,0,0,,Không phải đồ chơi đâu đấy...
Dialogue: 0,1:29:17.86,1:29:19.00,Flashback,,0,0,0,,Thằng bé không phải đồ chơi.
Dialogue: 0,1:29:19.41,1:29:20.31,Flashback,,0,0,0,,Mà nó là...
Dialogue: 0,1:29:21.40,1:29:22.56,Flashback,,0,0,0,,Hibiol của tôi.
Dialogue: 0,1:29:25.74,1:29:26.61,Default,,0,0,0,,Ra vậy...
Dialogue: 0,1:29:29.03,1:29:29.97,Default,,0,0,0,,Ra vậy...
Dialogue: 0,1:29:41.31,1:29:43.96,Flashback,,0,0,0,,Ariel, về sớm nha con.
Dialogue: 0,1:29:44.93,1:29:46.36,Flashback,,0,0,0,,Mẹ!
Dialogue: 0,1:29:46.80,1:29:48.26,Flashback,,0,0,0,,Con về rồi!
Dialogue: 0,1:29:52.09,1:29:53.88,Flashback,,0,0,0,,Người con lạnh ngắt luôn này.
Dialogue: 0,1:29:56.94,1:29:58.95,Flashback,,0,0,0,,Mừng con về, Ariel.
Dialogue: 0,1:30:06.77,1:30:07.64,Default,,0,0,0,,Mừng con về.
Dialogue: 0,1:30:10.34,1:30:11.19,Default,,0,0,0,,Ariel.
Dialogue: 0,1:30:15.27,1:30:15.97,Default,,0,0,0,,Mơ...
Dialogue: 0,1:30:16.93,1:30:18.29,Default,,0,0,0,,Không phải mơ đâu.
Dialogue: 0,1:30:19.39,1:30:21.84,Default,,0,0,0,,Nhưng tuyết...
Dialogue: 0,1:30:22.64,1:30:25.19,Default,,0,0,0,,Không phải tuyết đâu, là tro đấy.
Dialogue: 0,1:30:36.82,1:30:39.83,Default,,0,0,0,,Con của con và Dita chào đời rồi.
Dialogue: 0,1:30:43.35,1:30:44.31,Default,,0,0,0,,Đừng cố quá!
Dialogue: 0,1:30:45.00,1:30:47.87,Default,,0,0,0,,Không sao, họ đều đang đợi con về mà.
Dialogue: 0,1:30:48.37,1:30:50.81,Default,,0,0,0,,Họ vẫn luôn đợi con về mà.
Dialogue: 0,1:30:53.76,1:30:55.23,Default,,0,0,0,,Vậy ra con...
Dialogue: 0,1:30:56.24,1:30:58.27,Default,,0,0,0,,cũng ra đời như vậy nhỉ.
Dialogue: 0,1:31:04.56,1:31:10.72,Default,,0,0,0,,Mẹ con đã ôm con rất chặt.
Dialogue: 0,1:31:12.18,1:31:15.04,Default,,0,0,0,,Đến nỗi ngón tay bà ấy co cứng lại.
Dialogue: 0,1:31:15.90,1:31:17.49,Default,,0,0,0,,Khó khăn lắm mẹ mới lấy con ra được đấy.
Dialogue: 0,1:31:18.97,1:31:21.41,Default,,0,0,0,,Từng ngón, từng ngón một...
Dialogue: 0,1:31:21.95,1:31:22.77,Default,,0,0,0,,Thôi đi!
Dialogue: 0,1:31:22.87,1:31:23.62,Default,,0,0,0,,Mẹ...
Dialogue: 0,1:31:25.15,1:31:28.34,Default,,0,0,0,,không thể trở thành mẹ ruột của con được.
Dialogue: 0,1:31:28.34,1:31:29.33,Default,,0,0,0,,Đủ rồi!
Dialogue: 0,1:31:31.80,1:31:33.43,Default,,0,0,0,,Cô đã dạy cho tôi...
Dialogue: 0,1:31:34.28,1:31:35.15,Default,,0,0,0,,sự dịu dàng...
Dialogue: 0,1:31:35.88,1:31:36.76,Default,,0,0,0,,sức mạnh...
Dialogue: 0,1:31:37.50,1:31:38.34,Default,,0,0,0,,tuyệt vọng...
Dialogue: 0,1:31:39.70,1:31:41.80,Default,,0,0,0,,cảm giác khi yêu ai đó...
Dialogue: 0,1:31:47.88,1:31:49.89,Default,,0,0,0,,Nghĩ đến Ariel...
Dialogue: 0,1:31:50.89,1:31:53.51,Default,,0,0,0,,cũng giống như nghĩ về mẹ vậy.
Dialogue: 0,1:31:55.86,1:31:57.57,Default,,0,0,0,,Khi gặp được con ấy...
Dialogue: 0,1:31:58.32,1:32:01.88,Default,,0,0,0,,mẹ còn nghĩ là con sẽ khóc với mẹ...
Dialogue: 0,1:32:03.30,1:32:06.19,Default,,0,0,0,,rằng con là Hibiol của mẹ.
Dialogue: 0,1:32:09.11,1:32:10.72,Default,,0,0,0,,Khi ở bên con,
Dialogue: 0,1:32:11.35,1:32:14.84,Default,,0,0,0,,bao tui nhục, đau khổ mà mẹ phải chịu...
Dialogue: 0,1:32:16.02,1:32:17.32,Default,,0,0,0,,như nhẹ hẳn đi.
Dialogue: 0,1:32:19.28,1:32:21.39,Default,,0,0,0,,Ấy vậy mà tôi...
Dialogue: 0,1:32:22.05,1:32:22.90,Default,,0,0,0,,lại tránh mặt cô...
Dialogue: 0,1:32:24.75,1:32:26.96,Default,,0,0,0,,Ariel không nói dối mẹ.
Dialogue: 0,1:32:28.41,1:32:31.81,Default,,0,0,0,,Ariel đã giữ lời hứa.
Dialogue: 0,1:32:32.84,1:32:36.69,Default,,0,0,0,,Lúc nào con cũng bảo vệ mẹ mà.
Dialogue: 0,1:32:38.16,1:32:41.21,Default,,0,0,0,,Khi 2 ta xa nhau, rồi mẹ chỉ còn có một mình.
Dialogue: 0,1:32:41.84,1:32:44.24,Default,,0,0,0,,Lúc đó mẹ còn không biết bản thân là ai.
Dialogue: 0,1:32:45.60,1:32:48.31,Default,,0,0,0,,Nhưng khi nhớ lại Ariel,
Dialogue: 0,1:32:49.75,1:32:51.04,Default,,0,0,0,,mẹ đã trở về làm chính mình.
Dialogue: 0,1:32:52.70,1:32:57.79,Default,,0,0,0,,Nếu được nghe Ariel gọi, thì "Mẹ" hay gì cũng được.
Dialogue: 0,1:32:58.76,1:33:00.08,Default,,0,0,0,,Tên gì không quan trọng,
Dialogue: 0,1:33:00.82,1:33:04.52,Default,,0,0,0,,vì cái tên ấy rồi sẽ là của mẹ mà.
Dialogue: 0,1:33:06.40,1:33:11.03,Default,,0,0,0,,Người đã dệt nên mẹ bây giờ chính là Ariel mà.
Dialogue: 0,1:33:22.11,1:33:22.93,Default,,0,0,0,,Maquia!
Dialogue: 0,1:33:27.51,1:33:28.33,Default,,0,0,0,,Lang!
Dialogue: 0,1:33:29.22,1:33:31.28,Default,,0,0,0,,Cậu đưa Ariel đi theo được không?
Dialogue: 0,1:33:33.06,1:33:34.86,Default,,0,0,0,,Tới chỗ mẹ con Dita ấy.
Dialogue: 0,1:33:36.39,1:33:38.71,Default,,0,0,0,,Đến nơi mà Ariel thuộc về.
Dialogue: 0,1:33:50.42,1:33:51.39,Default,,0,0,0,,Đừng đi mà...
Dialogue: 0,1:33:59.79,1:34:00.93,Default,,0,0,0,,Đừng đi mà!
Dialogue: 0,1:34:01.70,1:34:02.92,Default,,0,0,0,,Mẹ!
Dialogue: 0,1:35:10.14,1:35:13.05,Default,,0,0,0,,Đến lúc xuống dưới rồi, thưa Medmel điện hạ.
Dialogue: 0,1:35:13.54,1:35:15.00,Default,,0,0,0,,Cha và những người khác đâu?
Dialogue: 0,1:35:19.12,1:35:21.62,Default,,0,0,0,,Ra vậy, không sao đâu.
Dialogue: 0,1:35:23.33,1:35:24.80,Default,,0,0,0,,Nếu ta xuống dưới,
Dialogue: 0,1:35:25.05,1:35:28.05,Default,,0,0,0,,thì sẽ phải bước vào một cuộc sống hoàn toàn khác.
Dialogue: 0,1:35:29.20,1:35:32.08,Default,,0,0,0,,Nhưng dù vậy, ta...
Dialogue: 0,1:35:48.74,1:35:49.97,Default,,0,0,0,,Cô là ai?
Dialogue: 0,1:35:53.24,1:35:54.50,Default,,0,0,0,,Leilia-sama...
Dialogue: 0,1:36:00.41,1:36:01.40,Default,,0,0,0,,Cô là...
Dialogue: 0,1:36:02.41,1:36:05.14,Default,,0,0,0,,mẹ... của ta...
Dialogue: 0,1:36:10.37,1:36:12.31,Default,,0,0,0,,Tôi là Leilia, người Iorph.
Dialogue: 0,1:36:14.11,1:36:18.51,Default,,0,0,0,,Một phụ nữ ngỗ nghịch, mạnh mẽ, hay cãi lại,
Dialogue: 0,1:36:20.87,1:36:21.80,Default,,0,0,0,,và cũng là một người...
Dialogue: 0,1:36:22.83,1:36:23.78,Default,,0,0,0,,tự do!
Dialogue: 0,1:36:27.44,1:36:29.03,Default,,0,0,0,,Leilia, bay đi!
Dialogue: 0,1:36:43.64,1:36:45.73,Default,,0,0,0,,Mình... có thể bay!
Dialogue: 0,1:36:48.75,1:36:49.24,Default,,0,0,0,,Không!
Dialogue: 0,1:36:49.24,1:36:50.37,Default,,0,0,0,,Mẹ!
Dialogue: 0,1:37:08.80,1:37:09.62,Default,,0,0,0,,Maquia.
Dialogue: 0,1:37:12.25,1:37:13.04,Default,,0,0,0,,Phải.
Dialogue: 0,1:37:14.45,1:37:15.98,Default,,0,0,0,,Mi cũng bay được mà nhỉ.
Dialogue: 0,1:37:22.74,1:37:23.80,Default,,0,0,0,,Vĩnh biệt!
Dialogue: 0,1:37:24.50,1:37:26.20,Default,,0,0,0,,Hãy quên mẹ đi!
Dialogue: 0,1:37:26.77,1:37:28.16,Default,,0,0,0,,Mẹ cũng sẽ quên con!
Dialogue: 0,1:37:28.93,1:37:31.81,Default,,0,0,0,,Những ngày ở trong thành, và cả buổi sáng hôm nay,
Dialogue: 0,1:37:31.93,1:37:33.40,Default,,0,0,0,,mẹ sẽ không viết vào Hibiol đâu!
Dialogue: 0,1:37:33.96,1:37:34.99,Default,,0,0,0,,Mẹ...
Dialogue: 0,1:37:35.53,1:37:39.16,Default,,0,0,0,,Những ký ức dài đằng đẵng này...
Dialogue: 0,1:37:40.12,1:37:41.65,Default,,0,0,0,,mẹ sẽ quên hết chúng!
Dialogue: 0,1:37:42.98,1:37:43.46,Default,,0,0,0,,Phải!
Dialogue: 0,1:37:44.58,1:37:46.42,Default,,0,0,0,,Chúng chỉ như sợi chỉ may thôi!
Dialogue: 0,1:37:52.79,1:37:53.27,Default,,0,0,0,,Vâng.
Dialogue: 0,1:37:53.79,1:37:57.60,Default,,0,0,0,,Mẹ ta đẹp thật nhỉ.
Dialogue: 0,1:38:01.94,1:38:03.07,Default,,0,0,0,,Medmel điện hạ...
Dialogue: 0,1:38:06.03,1:38:06.94,Default,,0,0,0,,Renato kìa!
Dialogue: 0,1:38:12.86,1:38:14.01,Default,,0,0,0,,Leilia-sama...
Dialogue: 0,1:38:16.35,1:38:17.66,Italics,,0,0,0,,Không cần đến Renato.
Dialogue: 0,1:38:18.64,1:38:19.94,Italics,,0,0,0,,Người Iorph cũng không cần.
Dialogue: 0,1:38:20.69,1:38:23.33,Italics,,0,0,0,,Vận mệnh nơi mà các sinh vật già nua đang dần biến mất.
Dialogue: 0,1:38:24.24,1:38:24.88,Italics,,0,0,0,,Đã vậy thì...
Dialogue: 0,1:38:25.81,1:38:28.35,Italics,,0,0,0,,đến phút chót, ta phải để họ làm những gì mình muốn.
Dialogue: 0,1:38:34.34,1:38:36.31,Default,,0,0,0,,Đừng khóc, Leilia.
Dialogue: 0,1:38:41.29,1:38:44.57,Default,,0,0,0,,Không sao đâu, nhất định sẽ không quên đâu mà.
Dialogue: 0,1:38:56.59,1:38:57.77,Default,,0,0,0,,Đau lòng lắm chứ.
Dialogue: 0,1:38:59.93,1:39:02.15,Default,,0,0,0,,Đau lòng lắm chứ...
Dialogue: 0,1:39:04.43,1:39:06.98,Default,,0,0,0,,Nhưng thế giới tuyệt đẹp này...
Dialogue: 0,1:39:07.94,1:39:09.70,Default,,0,0,0,,thì sao có thể quên được.
Dialogue: 0,1:39:42.80,1:39:43.65,Default,,0,0,0,,Anh về rồi đây.
Dialogue: 0,1:39:46.31,1:39:47.57,Default,,0,0,0,,Anh về rồi...
Dialogue: 0,1:39:49.34,1:39:50.50,Default,,0,0,0,,Dĩ nhiên rồi.
Dialogue: 0,1:40:05.39,1:40:07.39,Default,,0,0,0,,Con bé mềm đến sợ luôn.
Dialogue: 0,1:40:13.62,1:40:15.76,Default,,0,0,0,,Mình đặt tên cho con nhé em.
Dialogue: 0,1:40:18.15,1:40:18.84,Default,,0,0,0,,Dita?
Dialogue: 0,1:40:19.94,1:40:20.93,Default,,0,0,0,,Em xin lỗi.
Dialogue: 0,1:40:22.63,1:40:24.17,Default,,0,0,0,,Khi hai đứa mình con nhỏ,
Dialogue: 0,1:40:25.39,1:40:29.65,Default,,0,0,0,,"Con trai mà thích mẹ mới là lạ đấy"...
Dialogue: 0,1:40:30.89,1:40:31.89,Default,,0,0,0,,em đã nói như thế...
Dialogue: 0,1:40:33.84,1:40:35.52,Default,,0,0,0,,Không lạ chút nào đâu.
Dialogue: 0,1:40:36.41,1:40:40.17,Default,,0,0,0,,Mẹ anh rất đẹp...
Dialogue: 0,1:40:41.03,1:40:42.17,Default,,0,0,0,,lại còn tốt...
Dialogue: 0,1:40:44.13,1:40:44.81,Default,,0,0,0,,Em...
Dialogue: 0,1:40:49.05,1:40:51.01,Default,,0,0,0,,Nhất định đứa bé này...
Dialogue: 0,1:40:51.38,1:40:52.12,Default,,0,0,0,,Anh yêu em.
Dialogue: 0,1:40:53.68,1:40:54.82,Default,,0,0,0,,Em cũng yêu anh.
Dialogue: 0,1:40:55.94,1:41:01.52,Default,,0,0,0,,Nhưng lúc nào em cũng ghen tỵ với mẹ anh...
Dialogue: 0,1:41:04.26,1:41:08.16,Default,,0,0,0,,Anh, người được mẹ nuôi lớn, sẽ yêu thương em.
Dialogue: 0,1:41:10.12,1:41:12.62,Default,,0,0,0,,Con chúng ta rồi cũng sẽ gặp được ai đó.
Dialogue: 0,1:41:13.70,1:41:15.41,Default,,0,0,0,,Hãy cùng nhau nuôi nó nên người nhé.
Dialogue: 0,1:41:16.78,1:41:19.13,Default,,0,0,0,,Anh và em, hai chúng ta.
Dialogue: 0,1:41:20.41,1:41:23.72,Default,,0,0,0,,Từ bây giờ, con bé sẽ biết đến tình yêu thương.
Dialogue: 0,1:41:30.03,1:41:31.40,Italics,,0,0,0,,Tộc Ly biệt...
Dialogue: 0,1:41:33.16,1:41:35.17,Italics,,0,0,0,,đã chứng kiến vô số cuộc chia ly,
Dialogue: 0,1:41:36.21,1:41:38.08,Italics,,0,0,0,,lẫn vô số lần vạn vật đổi thay.
Dialogue: 0,1:41:39.33,1:41:42.56,Italics,,0,0,0,,Thời gian sẽ trôi mãi.
Dialogue: 0,1:41:44.54,1:41:47.61,Italics,,0,0,0,,Thế nên, ngày tái ngộ rồi sẽ đến.
Dialogue: 0,1:41:49.97,1:41:50.86,Italics,,0,0,0,,Tái ngộ...
Dialogue: 0,1:41:52.12,1:41:53.25,Italics,,0,0,0,,rồi tiếp tục dệt...
Dialogue: 0,1:42:08.56,1:42:09.54,Default,,0,0,0,,Chào buổi sáng.
Dialogue: 0,1:42:13.58,1:42:16.49,Default,,0,0,0,,Nhóc đưa ta đến gặp ông có được không?
Dialogue: 0,1:42:17.52,1:42:18.66,Default,,0,0,0,,Ông?
Dialogue: 0,1:42:18.77,1:42:19.92,Default,,0,0,0,,Lily!
Dialogue: 0,1:42:20.45,1:42:22.81,Default,,0,0,0,,Thế là không được đâu đấy!\NRa nãy giờ con ở đây à?
Dialogue: 0,1:42:25.16,1:42:26.09,Default,,0,0,0,,Cô là...
Dialogue: 0,1:42:30.06,1:42:32.59,Default,,0,0,0,,Mẹ cháu đã qua đời 3 năm về trước rồi.
Dialogue: 0,1:42:33.29,1:42:35.09,Default,,0,0,0,,Hai người họ yêu thương nhau lắm.
Dialogue: 0,1:42:35.84,1:42:37.46,Default,,0,0,0,,Sau khi vương triều Mezarte sụp đổ,
Dialogue: 0,1:42:37.86,1:42:40.28,Default,,0,0,0,,Lang-san đã đưa họ tới đây.
Dialogue: 0,1:42:41.72,1:42:45.78,Default,,0,0,0,,Dù gặp nhiều khó khăn, nhưng cháu nghĩ cuộc sống của họ vẫn rất ấm cúng.
Dialogue: 0,1:42:52.58,1:42:54.06,Default,,0,0,0,,Khoan đã!
Dialogue: 0,1:42:54.06,1:42:56.60,Default,,0,0,0,,Họ kể cho cháu nghe nhiều chuyện về bà lắm.
Dialogue: 0,1:42:57.39,1:42:59.56,Default,,0,0,0,,Cả 2 người, kể một cách rất hạnh phúc.
Dialogue: 0,1:43:00.69,1:43:02.37,Default,,0,0,0,,Thật tốt vì bà đã tới kịp.
Dialogue: 0,1:43:03.27,1:43:04.87,Default,,0,0,0,,Cha cháu đã...
Dialogue: 0,1:43:35.63,1:43:36.47,Default,,0,0,0,,Mẹ về rồi đây.
Dialogue: 0,1:43:37.16,1:43:37.97,Default,,0,0,0,,Ariel.
Dialogue: 0,1:43:48.65,1:43:50.90,Default,,0,0,0,,Con giỏi thật đấy, Ariel.
Dialogue: 0,1:43:55.40,1:43:56.28,Default,,0,0,0,,Con...
Dialogue: 0,1:44:00.29,1:44:04.03,Default,,0,0,0,,đã sống hết mình nhỉ?
Dialogue: 0,1:44:04.46,1:44:05.29,Default,,0,0,0,,Ariel.
Dialogue: 0,1:44:11.13,1:44:12.19,Default,,0,0,0,,Mẹ sẽ không khóc đâu.
Dialogue: 0,1:44:13.14,1:44:15.44,Default,,0,0,0,,Mẹ hứa rồi mà.
Dialogue: 0,1:44:29.75,1:44:33.67,Default,,0,0,0,,Mừng... mẹ... về...!
Dialogue: 0,1:44:42.38,1:44:43.35,Default,,0,0,0,,Mẹ về rồi đây.
Dialogue: 0,1:45:32.17,1:45:34.42,Default,,0,0,0,,Lên đường bình an nhé, Ariel.
Dialogue: 0,1:45:36.26,1:45:39.92,Default,,0,0,0,,Mẹ sẽ về trước bữa tối.
Dialogue: 0,1:45:46.31,1:45:47.22,Default,,0,0,0,,Cho nè!
Dialogue: 0,1:45:48.13,1:45:49.16,Default,,0,0,0,,Cảm ơn cháu.
Dialogue: 0,1:46:09.60,1:46:12.89,Flashback,,0,0,0,,{\fad(1000,0)}Mẹ, mẹ ơi...!
Dialogue: 0,1:46:12.80,1:46:14.14,Flashback,,0,0,0,,Mẹ về rồi!
Dialogue: 0,1:46:14.14,1:46:14.92,Flashback,,0,0,0,,Mẹ nè...
Dialogue: 0,1:46:15.12,1:46:15.86,Flashback,,0,0,0,,Mẹ nè...!
Dialogue: 0,1:46:15.77,1:46:17.33,Flashback,,0,0,0,,Con về rồi nè!
Dialogue: 0,1:46:17.62,1:46:18.37,Flashback,,0,0,0,,Chào buổi sáng!
Dialogue: 0,1:46:19.57,1:46:20.85,Flashback,,0,0,0,,Lừa được mẹ rồi!
Dialogue: 0,1:46:20.78,1:46:22.93,Flashback,,0,0,0,,Mẹ tưởng đó là bộ da của con phải không?
Dialogue: 0,1:46:22.82,1:46:24.41,Flashback,,0,0,0,,Con được sinh ra ở đâu vậy mẹ?
Dialogue: 0,1:46:24.33,1:46:26.65,Flashback,,0,0,0,,Có mấy con bọ ngọ nguậy ở đây nè!
Dialogue: 0,1:46:26.48,1:46:28.01,Flashback,,0,0,0,,Mẹ cười rồi!
Dialogue: 0,1:46:28.82,1:46:31.06,Flashback,,0,0,0,,Rằng mama khác mọi người lắm đó.
Dialogue: 0,1:46:30.50,1:46:31.71,Flashback,,0,0,0,,Thôi mà!
Dialogue: 0,1:46:31.39,1:46:32.69,Flashback,,0,0,0,,Coi nè mẹ!
Dialogue: 0,1:46:32.62,1:46:34.15,Flashback,,0,0,0,,Tại sao vậy mẹ?
Dialogue: 0,1:46:35.22,1:46:37.84,Flashback,,0,0,0,,Khi ở đây, mẹ chẳng giống mẹ chút nào!
Dialogue: 0,1:46:37.74,1:46:40.41,Flashback,,0,0,0,,Không được làm mẹ tôi khóc!
Dialogue: 0,1:46:40.41,1:46:42.64,Flashback,,0,0,0,,Miễn có mẹ ở bên là được rồi.
Dialogue: 0,1:46:42.56,1:46:44.06,Flashback,,0,0,0,,Con sẽ bảo vệ mẹ!
Dialogue: 0,1:46:43.89,1:46:44.67,Flashback,,0,0,0,,Mẹ...
Dialogue: 0,1:46:45.00,1:46:45.93,Flashback,,0,0,0,,Mẹ...
Dialogue: 0,1:46:45.55,1:46:46.25,Flashback,,0,0,0,,Mẹ...!
Dialogue: 0,1:46:47.04,1:46:48.99,Flashback,,0,0,0,,Không sao, tôi tự làm được.
Dialogue: 0,1:46:48.75,1:46:49.60,Flashback,,0,0,0,,Tôi đi nhé.
Dialogue: 0,1:46:49.42,1:46:50.48,Flashback,,0,0,0,,Sẽ đâu vào đó thôi mà.
Dialogue: 0,1:46:50.76,1:46:51.36,Flashback,,0,0,0,,Chờ chút.
Dialogue: 0,1:46:52.07,1:46:52.91,Flashback,,0,0,0,,Biết rồi mà.
Dialogue: 0,1:46:52.91,1:46:53.77,Flashback,,0,0,0,,Gì vậy chứ!?
Dialogue: 0,1:46:53.70,1:46:54.40,Flashback,,0,0,0,,Đừng lo.
Dialogue: 0,1:46:54.56,1:46:55.59,Flashback,,0,0,0,,Ghét thật!
Dialogue: 0,1:46:55.65,1:46:56.26,Flashback,,0,0,0,,Về rồi đây.
Dialogue: 0,1:46:56.18,1:46:58.89,Flashback,,0,0,0,,Tôi không có coi cô là mẹ!
Dialogue: 0,1:46:58.68,1:47:00.40,Flashback,,0,0,0,,Ai mà biết chứ!
Dialogue: 0,1:47:00.40,1:47:01.64,Flashback,,0,0,0,,Em muốn bảo vệ bà ấy...
Dialogue: 0,1:47:01.64,1:47:02.71,Flashback,,0,0,0,,Nhưng với con người hiện tại của em thì làm sao được.
Dialogue: 0,1:47:02.58,1:47:04.89,Flashback,,0,0,0,,Em không thể tự mình bảo vệ người ấy được!
Dialogue: 0,1:47:05.15,1:47:09.69,Flashback,,0,0,0,,Tại sao người ấy lại coi em như báu vật kia chứ?!
Dialogue: 0,1:47:10.28,1:47:11.69,Flashback,,0,0,0,,Cô đã dạy cho tôi...
Dialogue: 0,1:47:12.28,1:47:13.27,Flashback,,0,0,0,,Đừng đi mà!
Dialogue: 0,1:47:13.85,1:47:15.65,Flashback,,0,0,0,,{\fad(0,1000)}Mẹ!
Dialogue: 0,1:47:15.65,1:47:17.54,Default,,0,0,0,,Ariel, xin lỗi con nhé.
Dialogue: 0,1:47:18.49,1:47:19.41,Flashback,,0,0,0,,Mẹ...?
Dialogue: 0,1:47:20.47,1:47:21.48,Default,,0,0,0,,Xin lỗi con nhé.
Dialogue: 0,1:47:22.31,1:47:23.73,Flashback,,0,0,0,,Mẹ sẽ không khóc đâu!
Dialogue: 0,1:47:24.33,1:47:26.18,Flashback,,0,0,0,,Bởi mẹ là mẹ của con mà!
Dialogue: 0,1:47:27.27,1:47:28.47,Flashback,,0,0,0,,Hứa rồi nhá!
Dialogue: 0,1:47:29.63,1:47:34.60,Default,,0,0,0,,{\fad(0,500)}Lời hứa với con, mẹ không giữ được rồi!
Dialogue: 0,1:47:39.60,1:47:41.39,Flashback,,0,0,0,,{\fad(500,00)}Mẹ ơi!
Dialogue: 0,1:47:45.97,1:47:47.83,Flashback,,0,0,0,,Con yêu mẹ!
Dialogue: 0,1:47:50.05,1:47:51.50,Flashback,,0,0,0,,{\fad(0,500)}Yêu mẹ lắm luôn!
Dialogue: 0,1:48:03.95,1:48:05.02,Italics,,0,0,0,,Ariel...
Dialogue: 0,1:48:11.48,1:48:12.57,Italics,,0,0,0,,Ariel...!
Dialogue: 0,1:48:32.88,1:48:34.03,Default,,0,0,0,,Xong rồi à?
Dialogue: 0,1:48:35.14,1:48:36.08,Default,,0,0,0,,Không kết thúc đâu.
Dialogue: 0,1:48:36.90,1:48:38.58,Default,,0,0,0,,Một khi tôi còn sống,
Dialogue: 0,1:48:39.45,1:48:41.97,Default,,0,0,0,,thì Hibiol của Ariel cũng sẽ không dừng lại.
Dialogue: 0,1:48:45.38,1:48:46.96,Default,,0,0,0,,Đừng có cười chứ.
Dialogue: 0,1:48:47.26,1:48:50.37,Default,,0,0,0,,Trưởng lão mà thấy cái mặt của cô sẽ cười cho mà xem.
Dialogue: 0,1:48:57.71,1:48:58.99,Default,,0,0,0,,Kiểu gì bà ấy cũng cười cho xem.
Dialogue: 0,1:48:59.41,1:49:03.71,Default,,0,0,0,,Vì nhờ cô mà bà ấy mới biết \Nrằng chia ly không chỉ có đau thương mà.
Dialogue: 0,1:49:08.22,1:49:09.57,Default,,0,0,0,,Nào, đi thôi.
Dialogue: 0,1:49:10.06,1:49:13.05,Default,,0,0,0,,Vì những cuộc chia ly đang đợi chờ ta phía trước.
Dialogue: 0,1:49:21.78,1:49:22.86,Italics,,0,0,0,,Trưởng lão.
Dialogue: 0,1:49:24.70,1:49:30.88,Italics,,0,0,0,,Con nghĩ mình rất may mắn vì đã yêu Ariel.
Dialogue: 0,1:49:33.37,1:49:38.00,Italics,,0,0,0,,{\fad(0,1000)}Thật tốt... vì con đã yêu thằng bé...
